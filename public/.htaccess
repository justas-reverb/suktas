ErrorDocument 404 /404.html
Redirect 301 /zodynas/socialine-inzinerija/ /temos/socialine-inzinerija/
<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp|avif|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
    Header set Cache-Control "public, max-age=0, s-maxage=86400" "expr=%{HTTP_HOST} == 'suktas.lt' && %{REQUEST_STATUS} -lt 400"
  </FilesMatch>
</IfModule>
