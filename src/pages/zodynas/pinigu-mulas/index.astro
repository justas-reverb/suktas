---
/**
 * Žodynas: Kas yra pinigų mulas, the second glossary entry with a page of its own. The copy is
 * docs/copy/zodynas/pinigu-mulas.md, word for word; the source tags stay as comments and the build
 * strips them. It wears the scenario template, as /zodynas/phishing/ does.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const meta = [
  ['Angliškai', 'money mule'],
  ['Skaitymo laikas', '4 min.'],
];

const ways = [
  ['Darbo skelbimas.', ' Socialiniuose tinkluose ir darbo skelbimuose žadamas greitas uždarbis be pastangų. <!-- F383 --> Netikri skelbimai siūlo apskaitininko, buhalterio ar sistemų testuotojo darbą arba atlygį už „sąskaitų administravimą“. <!-- F383 --> SEB aprašė darbo iš namų pasiūlymą – būti „pinigų pervedimo agentu“: tereikėjo asmeninės banko sąskaitos numerio. <!-- F391 -->'],
  ['Užduotys su pervedimais.', ' Prašoma naudoti asmeninę sąskaitą pervedimams: neva pinigai skirti labdarai arba siūloma tapti „slaptu pirkėju“ ir surinktas lėšas pervesti kitam, o už kiekvieną pervedimą žadamas priedas. <!-- F395 --> „Swedbank“ aprašytu atveju mergina tikėjo įsidarbinusi apskaitininke: jos prašė priimti „įmonės“ klientų mokėjimus ir persiųsti juos į sąskaitą Maltoje, už tai žadėjo 10 % nuo sumų. <!-- F392 -->'],
  ['Įprastas darbas ir „dar viena smulkmena“.', ' Gali būti pasiūlyta pakuoti prekes ar siuntinius, bet kartu paprašyta prieigos prie tavo banko sąskaitos. <!-- F391 -->'],
  ['„Paskolink sąskaitą“.', ' Sukčiai pasakoja, kad jų sąskaitą neteisingai areštavo antstoliai ar ji užblokuota per klaidą, pagalbos reikia skubiai, o už ją žadama 50, 100 ar net 200 eurų (SEB atstovo aprašytos 2020 m. istorijos). <!-- F394 --> Lietuvos banko aprašytu atveju žmogus už kiekvieną į savo sąskaitą gautą pavedimą galėjo pasilikti po 3 eurus, o likusius pinigus turėjo persiųsti kitam. <!-- F398 -->'],
  ['Sąskaita tavo vardu.', ' Prašoma atidaryti sąskaitą savo vardu ir leisti ja naudotis kitiems. <!-- F389 --> Tas pats būna ir su nuotolinių lošimų paskyromis. <!-- F384 -->'],
];

const signs = [
  ['Darbo dalis – pervedimai per tavo sąskaitą.', ' Tai vienas esminių netikro darbo požymių. <!-- F395 --> Jokia teisėta įmonė to neprašys, o patikima įmonė savo pinigams neieško atsitiktinių sąskaitų tarpininkų. <!-- F385 F392 -->'],
  ['Prašo leisti naudotis tavo sąskaita, atidaryti naują ar duoti prisijungimą.', ' Lietuvos bankas prašymą atidaryti sąskaitą ir leisti ja naudotis kitiems vadina aiškia indikacija, kad gali tapti pinigų mulu. <!-- F389 F345 -->'],
  ['Lengvi pinigai be jokių reikalavimų.', ' Žadamas greitas uždarbis be pastangų, nekeliami jokie išsilavinimo ar patirties reikalavimai. <!-- F383 F391 --> Jei pasiūlymas skamba per gerai, kad būtų tiesa, greičiausiai taip ir yra. <!-- F391 -->'],
  ['Tikina, kad nieko nerizikuoji, ir žada priedą, jei įtrauksi draugų.', ' Įtikinama, kad veikla visiškai nerizikinga, o už įtrauktus draugus žadamas didesnis atlygis. <!-- F389 F391 -->'],
  ['Skubina.', ' Pagalbos ar pervedimo reikia skubiai. <!-- F394 -->'],
];

const risks = [
  ['Bankas gali uždaryti kelią.', ' Bankai gali atsisakyti vykdyti operacijas ir nutraukti santykius su klientu. <!-- F395 --> SEB atstovas 2020 m. rašė, kad nustačius, jog į sąskaitą pateko pavogti pinigai, galimybė ja naudotis iškart apribojama: nebeveikia nei kortelė, nei interneto bankas. <!-- F394 --> FNTT rašo, kad užšaldomos visos žmogaus sąskaitos ir sugadinama kredito istorija. <!-- F386 -->'],
  ['Ilgam be finansinių paslaugų.', ' Kas paskolino sąskaitą svetimiems, rizikuoja ilgam ar apskritai niekada negauti paskolos, lizingo, kredito kortelės, net mokėjimo sąskaitos. <!-- F398 F392 -->'],
  ['Teisinės pasekmės.', ' FNTT, Lietuvos bankas ir bankai perspėja, kad gali grėsti baudžiamoji atsakomybė; FNTT rašo, kad toks žmogus laikomas nusikaltimo bendrininku. <!-- F386 F389 F390 --> SEB rašo, kad nežinojimas nuo atsakomybės neatleidžia. <!-- F390 --> Kaip tai vertina teisėsauga ir teismas, priklauso nuo atvejo; paskelbto nuosprendžio žmogui, kuris nežinojo, neradome. <!-- M -->'],
  ['Gali netekti savų pinigų ir saugumo.', ' Žadėto uždarbio gali ir negauti, o prarasti savų pinigų. <!-- F386 F388 --> SEB mini ir šantažą, grasinimus ar net smurtą. <!-- F390 -->'],
  ['Sukčiai dingsta, o klausimai lieka tau.', ' Kiti nukentėjusieji anksčiau ar vėliau kreipiasi į banką ar policiją, ir šie suranda sąskaitos savininką. <!-- F392 --> Sukčiai dingsta, o sąskaitą paskolinęs žmogus tampa atpirkimo ožiu. <!-- F394 -->'],
];

const steps = [
  '<strong>Sustabdyk.</strong> Daugiau nevykdyk jokių pervedimų ir neišimk grynųjų – nei jų nurodytų, nei savo iniciatyva atgal. <!-- F387 F393 F345 --> Ką daryti su atėjusiais pinigais, klausk banko. <!-- M -->',
  '<strong>Išsisaugok viską ir nutrauk ryšį.</strong> Pirma išsisaugok „darbdavio“ kontaktus ir susirašinėjimą, tada nutrauk bet kokį bendravimą. <!-- F396 -->',
  '<strong>Iškart susisiek su savo banku</strong> ir papasakok, kas vyko. <!-- F387 F393 F396 -->',
  '<strong>Pranešk policijai</strong> – per epolicija.lt, skambučiu 112 arba artimiausiame komisariate – ir padėk išsiaiškinti tikruosius nusikaltėlius. <!-- F396 F393 F2 -->',
];

const levers = [
  ['Nauda.', 'Lengvi pinigai ir priedas už kiekvieną pervedimą. <!-- F395 F383 -->'],
  ['Skuba.', 'Pagalbos reikia greitai, todėl nelieka laiko paklausti, kam iš tikrųjų reikia tavo sąskaitos. <!-- F394 M -->'],
  ['Gėda.', 'Kai paaiškėja, kas vyko, prisipažinti sunku, o tyla padeda jam, ne tau. <!-- F392 M -->'],
];

const sides = [
  ['Darbas, kuriame reikia priimti ir persiųsti pinigus', 'Nepriimk tokio darbo. <!-- F395 F385 -->'],
  ['„Paskolink sąskaitą, mano areštuota“', 'Neskolink: per tavo sąskaitą būtų plaunami svetimi pinigai. <!-- F390 F346 -->'],
  ['Prašo atidaryti sąskaitą tavo vardu ar duoti prisijungimą', 'Atsisakyk. <!-- F388 F389 -->'],
  ['„Nieko nerizikuoji, o įtrauk draugų – gausi daugiau“', 'Rizikuoji sąskaita ir kredito istorija, o gali sulaukti ir teisinių pasekmių. <!-- F386 F389 -->'],
  ['Pinigai jau atėjo, ir jis ragina skubiai persiųsti', 'Nepersiųsk; skambink bankui. <!-- F387 F393 -->'],
];

const sources = [
  'Finansinių nusikaltimų tyrimo tarnyba („FNTT paaiškina: kas yra pinigų mulai ir kaip jais netapti“, atnaujinta 2023-10-04): apibrėžimas, kaip tampama, lošimų paskyros, patarimai, pasekmės, ką daryti. <!-- F382 F383 F384 F385 F386 F387 -->',
  'Lietuvos bankas (2020-08-26, 2023-09-19; „Pinigų mulai“, atnaujinta 2024-10-28): apibrėžimas, kanalai, į ką taikomasi, prašymas kaip požymis, 3 eurų atvejis, paskolos ir lizingas, ką daryti. <!-- F388 F389 F398 F345 -->',
  'SEB (2024-03-20; A. Šapola, LRT, 2020-04-09): nežinojimas neatleidžia, pasekmės, „pinigų pervedimo agentas“, kanalai, „paskolink sąskaitą“, ką daro bankas. <!-- F390 F391 F394 -->',
  '„Swedbank“ (2022-08-24, 2022-10-14): „apskaitininkės“ atvejis, kaip surandami pinigų mulai, paskolos, ką daryti. <!-- F392 F393 -->',
  '„Luminor“ (2024-04-17; paninfo.lt, 2025-05-09): darbo požymiai, patarimai, ką daryti, vaikai. <!-- F395 F396 F397 -->',
  'Policija (alkas.lt, 2020-02-14): persiunčiant pinigus už sukčius galima prisidėti prie pinigų plovimo; pranešti per epolicija.lt. <!-- F346 F2 -->',
];
---
<Page
  title="Kas yra pinigų mulas ir kaip netapti pinigų mulu – Suktas"
  description="Pinigų mulas – žmogus, per kurio sąskaitą sukčiai praleidžia svetimus pinigus. Kaip tuo tampama, kas gresia ir ką daryti, jei jau sutikai."
>
  <article class="scn card">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <p class="crumb"><a href="/zodynas/">Žodynas</a></p>
        <h1>{nb('Kas yra pinigų mulas')}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-11-02</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap">
      <div class="row">
        <h2>Trumpai</h2>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Pinigų mulas – žmogus, kuris į savo banko sąskaitą gauna pinigus iš vienų žmonių ir perveda juos kitiems arba išgrynina ir perduoda nusikaltėliams, dažnai už tam tikrą atlygį. <!-- F388 --> Taip nusikaltėliai slepia neteisėtai gautų pinigų kilmę ir savo tapatybę, o atsakomybę permeta kitam. <!-- F382 F388 --> Nemaža dalis žmonių pinigų mulais gali tapti patys to neįtardami, nes jie patys tapo apgaulės aukomis. <!-- F382 F345 -->')} />
        </div>
      </div>

      <div class="row">
        <h2>Kaip tampama pinigų mulu</h2>
        <div class="row__body">
          <ul class="row-list">
            {ways.map(([head, text]) => <li><strong set:html={nbHtml(head)} /><Fragment set:html={nbHtml(text)} /></li>)}
          </ul>
          <p set:html={nbHtml('Su pasiūlymais kreipiamasi visaip: asmeniškai, el. paštu, telefonu, per darbo skelbimus, pažinčių svetaines ir socialinius tinklus. <!-- F388 --> SEB vardija „Facebook“, „Instagram“, „TikTok“, „WhatsApp“ ir „Viber“. <!-- F391 -->')} />
        </div>
      </div>

      <div class="row">
        <h2>Į ką taikomasi</h2>
        <div class="row__body">
          <p set:html={nbHtml('Neretai į tuos, kurie gauna mažesnes pajamas ar patiria finansinių sunkumų: studentus, į šalį atvykusius žmones, bedarbius, pensininkus. <!-- F388 F389 --> Lietuvos bankas pastebi, kad dažniau verbuojami 18–34 metų vyrai. <!-- F389 --> Pinigų mulais gali tapti ir moksleiviai: jiems rašoma socialiniuose tinkluose, kad tereikia leisti panaudoti savo sąskaitą arba išimti grynųjų iš bankomato ir perduoti juos kitam. <!-- F383 F397 --> Vaikui net maža suma gali atrodyti didelė. <!-- F397 --> Pasakyk tai ir vaikui: savo sąskaitos niekam neskolink. <!-- M -->')} />
        </div>
      </div>

      <div class="row">
        <h2>Kaip atpažinti</h2>
        <div class="row__body">
          <ol class="signs" role="list">
            {signs.map(([head, text]) => (
              <li><p><strong set:html={nbHtml(head)} /><Fragment set:html={nbHtml(text)} /></p></li>
            ))}
          </ol>
        </div>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h2 id="ejimas">Tavo ėjimas</h2>
        <p class="move__line" set:html={nbHtml('Savo sąskaitos niekam neskolink: neatidaryk sąskaitos kito prašymu, neperduok prisijungimo ir nepriimk į ją svetimų pinigų persiųsti. Darbas, kuriame reikia pervedinėti pinigus per savo sąskaitą, – ne darbas.')} />
        <p set:html={nbHtml('Abejoji dėl pasiūlymo? Pasitark su draugais ar artimaisiais. <!-- F395 -->')} />
        <p set:html={nbHtml('Kortelė: <a href="/sustok/desimt-sekundziu/">Sustok dešimčiai sekundžių</a>.')} />
      </section>

      <div class="row">
        <h2>Kas gresia</h2>
        <div class="row__body">
          <ul class="row-list">
            {risks.map(([head, text]) => <li><strong set:html={nbHtml(head)} /><Fragment set:html={nbHtml(text)} /></li>)}
          </ul>
        </div>
      </div>

      <section class="box" aria-labelledby="sutikai">
        <h2 id="sutikai">Jei jau sutikai</h2>
        <p set:html={nbHtml('Tai gali nutikti bet kam: daug pinigų mulų patys nežino, kad padeda sukčiams. <!-- F382 F390 --> Baimė dėl pasekmių ar gėda gali kelti abejonių, ar verta prisipažinti, bet delsti šioje situacijoje neverta. <!-- F392 --> FNTT, Lietuvos bankas ir bankai pataria tą patį: kuo greičiau sustoti ir kreiptis į banką bei policiją. <!-- F387 F345 F393 F396 -->')} />
        <ol>
          {steps.map((s) => <li set:html={nbHtml(s)} />)}
        </ol>
        <p set:html={nbHtml('Jei netekai ir savų pinigų: <a href="/jei-apgavo/">Jei tave apgavo</a>.')} />
      </section>

      <div class="cta">
        <a class="btn" href="/sustok/desimt-sekundziu/">Atidaryk kortelę</a>
        <a class="btn btn--second" href="/jei-apgavo/">Jei tave apgavo</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Ne tavo darbo, o tavo sąskaitos: SEB aprašytu atveju „nusikaltėliams reikėjo ne darbščių rankų, o sąskaitos“. <!-- F391 --> Per svetimą sąskaitą jis praleidžia pinigus, lieka anonimiškas, o atsakomybę permeta tau. <!-- F388 --> <strong class="stop">Sustabdymo vieta:</strong> tavo sąskaita – tik tavo pinigams. <!-- F385 M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Dažnai nieko: skelbimą ar žinutę jis paleidžia daugybei žmonių. <!-- M --> Bet neretai taikosi į tuos, kurie gauna mažesnes pajamas ar patiria finansinių sunkumų: studentus, bedarbius, pensininkus. <!-- F388 F389 --> <strong class="stop">Sustabdymo vieta:</strong> kuo labiau reikia pinigų, tuo atidžiau skaityk pasiūlymą. <!-- M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jis naudoja tris iš penkių kabliukų, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>: <!-- M -->')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
            <p set:html={nbHtml('<strong class="stop">Sustabdymo vieta:</strong> dešimt sekundžių ir vienas klausimas – kodėl svetimiems reikia būtent mano sąskaitos? <!-- M --> <a href="/sustok/desimt-sekundziu/">Kortelė</a>.')} />
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Kortelės:</strong> <a href="/sustok/desimt-sekundziu/">{nb('Sustok dešimčiai sekundžių')}</a></li>
          <li><strong>Temos:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a>, <a href="/temos/kaip-veikia-atakos/">{nb('Kaip veikia atakos')}</a></li>
          <li><strong>Scenarijai:</strong> <a href="/scenarijai/meile-internete/">{nb('Meilė internete, kuri prašo pinigų')}</a>, <a href="/scenarijai/padesime-atsiimti-pensija/">{nb('„Padėsime atsiimti pensiją“')}</a>, <a href="/scenarijai/uzduotys-uz-pinigus/">{nb('Užduotys už pinigus')}</a></li>
          <li><strong>Žodynas:</strong> <a href="/zodynas/phishing/">{nb('Kas yra phishing')}</a>, <a href="/zodynas/nelegalus-kazino/">{nb('Kas yra nelegalus kazino')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-11-02. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
