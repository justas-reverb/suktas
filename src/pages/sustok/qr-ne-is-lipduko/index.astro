---
/**
 * Sustok kortelė: Neskenuok QR lipduko. The copy is docs/copy/sustok/qr-ne-is-lipduko.md, word
 * for word. Built from the Scenarijus parts (head, rows, the move, the box), one layer only.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('Neskenuok QR lipduko – atsidaryk oficialią programėlę');
---
<Page
  title="Neskenuok QR lipduko – Suktas"
  description="Kai QR kodas ant parkavimo automato ar kito viešo daikto kviečia sumokėti: neskenuok, mokėk oficialioje programėlėje."
  current="sustok"
>
  <article class="scn card">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <p class="crumb"><a href="/sustok/">Visi įpročiai</a></p>
        <h1>{title}</h1>
      </div>
    </header>

    <section class="layer wrap">
      <div class="row">
        <h2>Kada</h2>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Kai ant parkavimo automato ar panašaus viešo daikto prilipdytas QR kodas kviečia sumokėti. <!-- F101 M -->')} />
        </div>
      </div>

      <section class="move" aria-labelledby="daryti">
        <h2 id="daryti">Ką daryti</h2>
        <p class="move__line" set:html={nbHtml('Neskenuok QR kodo iš lipduko – atsidaryk oficialią paslaugos programėlę ir mokėk ten.')} />
        <p set:html={nbHtml('<!-- F101 M --> Vilniuje už parkavimą mokėk oficialioje programėlėje arba SMS žinute, o apie užklijuotus QR lipdukus pranešk „JUDU“. <!-- F101 -->')} />
      </section>

      <div class="row">
        <h2>Kodėl tai veikia</h2>
        <div class="row__body">
          <p set:html={nbHtml('Lipduką gali užklijuoti bet kas, o „JUDU“ sako, kad jos QR kodai yra tik viešajame transporte, todėl kodas ant parkavimo automato yra ženklas, kad kažkas negerai. <!-- F101 M --> „Smart-ID“ taisyklė ta pati: nuskaityk tik tų paslaugų kodus, kuriomis pasitiki, ir patikrink, ar programėlėje rodoma paslauga ir veiksmas sutampa su tuo, ką pradėjai. <!-- F35 -->')} />
        </div>
      </div>

      <div class="row row--last">
        <h2>Kur jis tai bando</h2>
        <div class="row__body">
          <ul>
            <li><a href="/scenarijai/netikras-qr-kodas/">{nb('Netikras QR kodas')}</a></li>
          </ul>
        </div>
      </div>

      <div class="cta">
        <a class="btn" href="/scenarijai/netikras-qr-kodas/">Pamatyk, kaip jis tai bando</a>
        <a class="btn btn--second" href="/sustok/">Kitos kortelės</a>
      </div>

      <section class="box" aria-labelledby="padarei">
        <h2 id="padarei">Jei jau prisigavai</h2>
        <p set:html={nbHtml('Jei jau nuskenavai kodą ir įvedei kortelės ar prisijungimo duomenis, skambink bankui: <a href="/jei-apgavo/#kortele">Jei tave apgavo: pasakiau kortelės duomenis</a>.')} />
      </section>
    </section>

    <footer class="scn-foot wrap">
      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-10-25. LRT, 2026-07-10 (cituoja „JUDU“): ant Vilniaus parkavimo automatų užklijuoti netikri QR lipdukai veda į netikrą mokėjimo puslapį; „JUDU“ QR kodai yra tik viešajame transporte; už parkavimą mokama oficialioje programėlėje arba SMS žinute; apie lipdukus pranešama „JUDU“. <!-- F101 --> „Smart-ID“: nuskaityk tik patikimų paslaugų kodus ir patikrink paslaugą bei veiksmą. <!-- F35 --> NKSC, 2026-07-13, pataria atsargiai elgtis su QR kodais (tekste apie pokalbių programėlių paskyras). <!-- F42 -->')} />
      </section>

      <Share />
    </footer>
  </article>
</Page>
