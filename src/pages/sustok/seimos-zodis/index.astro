---
/**
 * Sustok kortelė: Susitarkite šeimoje dėl žodžio. The copy is docs/copy/sustok/seimos-zodis.md,
 * word for word. Built like the QR card, with one more row, „Iš kur tai“: the advice is the
 * FBI's, and no Lithuanian body recommends it.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('Susitarkite šeimoje dėl žodžio');
---
<Page
  title="Susitarkite šeimoje dėl žodžio – Suktas"
  description="Kai artimas „skubiai“ prašo pinigų ar pagalbos: paprašyk žodžio, kurį žinote tik jūs, ir susisiek su juo kitu būdu."
  current="sustok"
>
  <article class="scn card">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <p class="crumb"><a href="/sustok/">Visi įpročiai</a></p>
        <h1>{title}</h1>
      </div>
    </header>

    <section class="layer wrap">
      <div class="row">
        <h2>Kada</h2>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Kai artimas žmogus „skubiai“ prašo pinigų ar pagalbos telefonu ar žinute. <!-- F81 -->')} />
        </div>
      </div>

      <section class="move" aria-labelledby="daryti">
        <h2 id="daryti">Ką daryti</h2>
        <p class="move__line" set:html={nbHtml('Susitarkite šeimoje dėl žodžio ar frazės, kurią žinote tik jūs.')} />
        <p set:html={nbHtml('<!-- F80 F81 --> Kai kas nors skubiai prašo pagalbos ar pinigų, paprašyk to žodžio, o prieš siunčiant pinigus pabandyk susisiekti su artimuoju kitu būdu. <!-- F81 -->')} />
      </section>

      <div class="row">
        <h2>Kodėl tai veikia</h2>
        <div class="row__body">
          <p set:html={nbHtml('Svetimas, apsimetantis artimuoju, šio žodžio nežino, todėl vien balsas ar „įrodymai“ nebeįtikina. <!-- F80 F81 -->')} />
        </div>
      </div>

      <div class="row row--last">
        <h2>Kur jis tai bando</h2>
        <div class="row__body">
          <ul>
            <li><a href="/scenarijai/draugas-praso-pinigu/">{nb('„Draugas“ prašo pinigų')}</a></li>
            <li><a href="/scenarijai/artimojo-avarija/">{nb('„Tavo sūnus pateko į avariją“')}</a></li>
          </ul>
        </div>
      </div>

      <div class="cta">
        <a class="btn" href="/seima/">Atsidaryk puslapį šeimai</a>
        <a class="btn btn--second" href="/sustok/">Kitos kortelės</a>
      </div>

      <section class="box" aria-labelledby="padarei">
        <h2 id="padarei">Jei jau prisigavai</h2>
        <p set:html={nbHtml('Jei jau išsiuntei pinigus apsimetėliui, skambink bankui; jei apgavo artimą žmogų, žiūrėk: <a href="/jei-apgavo/#artimas">Jei tave apgavo: apgavo artimą žmogų</a>.')} />
      </section>
    </section>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="iskur">
        <h2 id="iskur">Iš kur tai</h2>
        <p set:html={nbHtml('Tai JAV FBI patarimas, o ne Lietuvos institucijos. Lietuvoje jokios institucijos, rekomenduojančios šeimos žodį, neradome. <!-- F82 --> FBI interneto nusikaltimų skundų centras 2024 m. gruodžio 3 d. rekomendavo susitarti šeimoje dėl slapto žodžio ar frazės. <!-- F80 --> 2025 m. gruodžio 5 d. įspėjime apie netikrą pagrobimą, kai rodoma suklastota „įrodymų“ medžiaga, jis patarė susitarti dėl žodžio, kurį žino tik artimieji, ir prieš mokant visada bandyti susisiekti su artimuoju. <!-- F81 -->')} />
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-10-24. FBI IC3, PSA241203 (2024-12-03) ir PSA251205 (2025-12-05). <!-- F80 F81 -->')} />
      </section>

      <Share />
    </footer>
  </article>
</Page>
