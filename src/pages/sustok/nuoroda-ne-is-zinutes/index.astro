---
/**
 * Sustok kortelė: Nespausk nuorodos – atsidaryk programėlę ar svetainę. The copy is
 * docs/copy/sustok/nuoroda-ne-is-zinutes.md, word for word. Built like the QR card.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('Nespausk nuorodos – atsidaryk programėlę ar svetainę');

const sources = [
  'Lietuvos bankas, 2021-07-09: ignoruok skubius skambučius, SMS ar laiškus, kurie prašo „atsisiųsti ataskaitą“ ar spausti nuorodą; oficialioje programėlėje daryk tik tas operacijas, kurias pradėjai tu. <!-- F26 -->',
  'Lietuvos paštas, 2022-06-14: tikros žinutės neturi tiesioginės mokėjimo nuorodos ir neprašo kortelės duomenų. <!-- F44 -->',
  '„Omniva“: niekada neprašo kortelės duomenų; oficialūs adresai – omniva.ee, omniva.lv, omniva.lt. <!-- F45 -->',
  '„Sodra“, 2025-11-07: nesiunčia SMS ar laiškų, prašančių spausti nuorodą ar įvesti banko duomenis. <!-- F47 -->',
];
---
<Page
  title="Nespausk nuorodos – Suktas"
  description="Kai žinutė su nuoroda skubina sumokėti ar patvirtinti: nespausk, paslaugos programėlę ar svetainę atsidaryk be nuorodos."
  current="sustok"
>
  <article class="scn card">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <p class="crumb"><a href="/sustok/">Visi įpročiai</a></p>
        <h1>{title}</h1>
      </div>
    </header>

    <section class="layer wrap">
      <div class="row">
        <h2>Kada</h2>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Kai SMS, laiškas ar pokalbių žinutė su nuoroda sako, kad reikia sumokėti „mokestį“, atsisiųsti „ataskaitą“ ar kad „paskyra bus užblokuota“. <!-- F24 F26 F44 F45 -->')} />
        </div>
      </div>

      <section class="move" aria-labelledby="daryti">
        <h2 id="daryti">Ką daryti</h2>
        <p class="move__line" set:html={nbHtml('Nespausk nuorodos.')} />
        <p set:html={nbHtml('Atsidaryk paslaugos programėlę arba įvesk jos adresą naršyklėje ir patikrink ten. Oficialioje programėlėje ar svetainėje atlik tik tas operacijas, kurias pradėjai tu. <!-- F26 -->')} />
      </section>

      <div class="row">
        <h2>Kodėl tai veikia</h2>
        <div class="row__body">
          <p set:html={nbHtml('„Lietuvos paštas“, „Omniva“ ir „Sodra“ sako, kad jų tikrose žinutėse nėra mokėjimo nuorodų arba neprašoma kortelės duomenų, todėl pati nuoroda žinutėje jau yra pavojaus ženklas. <!-- F44 F45 F47 -->')} />
        </div>
      </div>

      <div class="row row--last">
        <h2>Kur jis tai bando</h2>
        <div class="row__body">
          <ul>
            <li><a href="/scenarijai/zinute-su-nuoroda/">{nb('Žinutė su nuoroda')}</a></li>
            <li><a href="/scenarijai/skambutis-is-banko/">{nb('Skambutis iš „banko“')}</a></li>
            <li><a href="/scenarijai/pirkejas-skelbime/">{nb('„Pirkėjas“ skelbime')}</a></li>
            <li><a href="/scenarijai/netikra-banko-reklama/">{nb('Netikra banko reklama')}</a></li>
            <li><a href="/scenarijai/programele-is-nuorodos/">{nb('Programėlė iš nuorodos ar reklamos')}</a></li>
            <li><a href="/scenarijai/netikras-di-irankis/">{nb('Netikras DI įrankis')}</a></li>
            <li><a href="/scenarijai/netikras-konkursas/">{nb('Netikras konkursas')}</a></li>
            <li><a href="/scenarijai/sms-apie-bauda/">{nb('SMS apie baudą')}</a></li>
            <li><a href="/scenarijai/netikras-laiskas/">{nb('Netikras laiškas iš „Sodros“, banko ar „Telia“')}</a></li>
            <li><a href="/scenarijai/netikra-valstybes-svetaine/">{nb('Netikra valstybės svetainė')}</a></li>
            <li><a href="/scenarijai/investicijos-telegram/">{nb('Reklama kviečia į „Telegram“, o ten auga „pelnas“')}</a></li>
          </ul>
        </div>
      </div>

      <div class="cta">
        <a class="btn" href="/scenarijai/zinute-su-nuoroda/">Pamatyk, kaip jis tai bando</a>
        <a class="btn btn--second" href="/sustok/">Kitos kortelės</a>
      </div>

      <section class="box" aria-labelledby="padarei">
        <h2 id="padarei">Jei jau prisigavai</h2>
        <p set:html={nbHtml('Jei jau paspaudei nuorodą ir įvedei duomenis, skambink bankui: <a href="/jei-apgavo/#kortele">Jei tave apgavo: pasakiau kortelės duomenis</a>.')} />
      </section>
    </section>

    <footer class="scn-foot wrap">
      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p>Patikrinta: <span class="nw">2026-10-24</span>.</p>
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
