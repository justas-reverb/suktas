---
/**
 * Sustok kortelė: Sustok dešimčiai sekundžių. The copy is docs/copy/sustok/desimt-sekundziu.md,
 * word for word. Built like the QR card: the Scenarijus parts, one layer only.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('Sustok dešimčiai sekundžių');
---
<Page
  title="Sustok dešimčiai sekundžių – Suktas"
  description="Kai kas nors sako „dabar“ ar „skubiai“: sustok dešimčiai sekundžių ir paklausk, ar šį veiksmą pradėjai tu."
  current="sustok"
>
  <article class="scn card">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <p class="crumb"><a href="/sustok/">Visi įpročiai</a></p>
        <h1>{title}</h1>
      </div>
    </header>

    <section class="layer wrap">
      <div class="row">
        <h2>Kada</h2>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Kai kas nors – balsu ar ekrane – sako „dabar“, „skubiai“ ar „kitaip paskyra bus užblokuota“. <!-- F24 -->')} />
        </div>
      </div>

      <section class="move" aria-labelledby="daryti">
        <h2 id="daryti">Ką daryti</h2>
        <p class="move__line" set:html={nbHtml('Sustok dešimčiai sekundžių ir paklausk savęs: ar šį veiksmą pradėjau aš?')} />
        <p set:html={nbHtml('Jei ne – nutrauk. <!-- F26 F32 -->')} />
      </section>

      <div class="row">
        <h2>Kodėl tai veikia</h2>
        <div class="row__body">
          <p set:html={nbHtml('Tikras bankas neskubina. Sukčiui skuba yra pagrindinis kabliukas, todėl pauzė atima iš jo laiką, kurio jam reikia. <!-- F25 M -->')} />
        </div>
      </div>

      <div class="row row--last">
        <h2>Kur jis tai bando</h2>
        <div class="row__body">
          <p>{nb('Beveik kiekvienas scenarijus remiasi skuba:')}</p>
          <ul>
            <li><a href="/scenarijai/skambutis-is-banko/">{nb('Skambutis iš „banko“')}</a></li>
            <li><a href="/scenarijai/skambutis-is-policijos/">{nb('Skambutis iš „policijos“')}</a></li>
            <li><a href="/scenarijai/zinute-su-nuoroda/">{nb('Žinutė su nuoroda')}</a></li>
            <li><a href="/scenarijai/meile-internete/">{nb('Meilė internete, kuri prašo pinigų')}</a></li>
            <li><a href="/scenarijai/grasina-paviesinti/">{nb('„Mokėk arba paviešinsiu tavo nuotraukas“')}</a></li>
            <li><a href="/scenarijai/uzduotys-uz-pinigus/">{nb('Užduotys už pinigus')}</a></li>
            <li><a href="/scenarijai/prekybos-kursai-ir-signalai/">{nb('Prekybos kursai ir signalai už pinigus')}</a></li>
            <li><a href="/scenarijai/netikra-nuoma/">{nb('Nuoma, kuri neegzistuoja')}</a></li>
            <li><a href="/scenarijai/bilietas-i-koncerta/">{nb('Bilietas į koncertą iš nepažįstamo žmogaus')}</a></li>
          </ul>
        </div>
      </div>

      <div class="cta">
        <a class="btn" href="/scenarijai/skambutis-is-banko/">Pamatyk, kaip jis tai bando</a>
        <a class="btn btn--second" href="/sustok/">Kitos kortelės</a>
      </div>

      <section class="box" aria-labelledby="padarei">
        <h2 id="padarei">Jei jau prisigavai</h2>
        <p set:html={nbHtml('Jei jau pasakei ar išsiuntei ką nors, kai tave skubino, skambink bankui: <a href="/jei-apgavo/">Jei tave apgavo</a>.')} />
      </section>
    </section>

    <footer class="scn-foot wrap">
      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-10-24. Kampanija „Padėk ragelį“ cituoja skubinančias frazes („paskyra bus užblokuota“, „būtina patvirtinti“) ir sako, kad bankas neskubina. <!-- F24 F25 --> Lietuvos bankas: daryk tik tas operacijas, kurias pradėjai tu. <!-- F26 -->')} />
      </section>

      <Share />
    </footer>
  </article>
</Page>
