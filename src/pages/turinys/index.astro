---
<Page
  title="Turinys – Suktas"
  description="Visi svetainės puslapiai vienoje vietoje: temos, scenarijai, patikra, įrankiai, žodynas ir ką daryti, jei tave apgavo."
>
  <section class="shead shead--plain" aria-labelledby="h1">
    <div class="wrap shead__body">
      <h1 id="h1">{nb('Turinys')}</h1>
    </div>
  </section>

  <div class="wrap toc">
    {groups.map(([name, links, soon]) => (
      <section class="toc__group" aria-labelledby={`g-${name}`}>
        <h2 id={`g-${name}`}>{nb(name)}</h2>
        <ul role="list">
          {links.map(([label, href]) => <li><a href={href}>{nb(label)}</a></li>)}
          {soon && <li class="soon-line">{nb(soon)}</li>}
        </ul>
      </section>
    ))}
  </div>

  <div class="wrap shelf-actions">
    <a class="btn" href="/scenarijai/">{nb('Atversk scenarijus')}</a>
  </div>
</Page>
