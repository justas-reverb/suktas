---
/**
 * Scenarijus: „Pareigūnas“ prie durų. The copy is docs/copy/scenarijai/pareigunas-prie-duru.md,
 * word for word; the source tags stay as comments and the build strips them.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('„Pareigūnas“ prie durų');
const meta = [
  ['Kanalas', 'skambutis ir vizitas namuose'],
  ['Ko jis nori', 'kad grynuosius, kortelę ar auksą atiduotum jam į rankas'],
  ['Skaitymo laikas', '3 min.'],
];

const signs = [
  ['Kažkas atvyksta paimti ar „patikrinti“ tavo pinigų, kortelės ar aukso.', 'Policija sako: pareigūnai niekada nerenka pinigų žmonių namuose ir netikrina jų grynųjų tikrumo, nesiunčia kurjerių pasiimti turto ir neprašo pirkti aukso. <!-- F277 F278 --> „Luminor“ primena: bankai, policija ar kitos institucijos neprašo atsiųsti kortelių su PIN kodais. <!-- F289 -->'],
  ['Prieš tai skambino „poliklinika“, „policija“ ar „bankas“ ir gąsdino', 'kratomis, „padirbtais“ pinigais ar neva nesaugiomis santaupomis banke. <!-- F278 F279 -->'],
  ['Prašo išgryninti pinigus arba nieko nesakyti artimiesiems.', 'Policija neprašo skubiai pervesti ar išsigryninti pinigų ir nereikalauja slėpti informacijos nuo artimųjų. <!-- F278 -->'],
];

const levers = [
  ['Autoritetas.', 'Policijos pareigūnas prie durų atrodo tikras, o „bankas“ ir „policija“ skambina vienas po kito. <!-- F277 F280 M -->'],
  ['Baimė.', 'Kratos, „padirbti“ pinigai ir „nesaugios“ santaupos verčia veikti, o ne klausti. <!-- F278 -->'],
  ['Skuba.', 'Skambučiai vienas po kito ir atvykimas tą pačią dieną nepalieka laiko pasitarti; policija pati sako, kad neprašo skubiai išsigryninti ar perduoti pinigų. <!-- F283 F278 F280 M -->'],
];

const sides = [
  ['„Tavo pinigai padirbti, juos reikia patikrinti“', 'Policija grynųjų namuose netikrina. Neleisk skaičiuoti ir „tikrinti“, nieko neatiduok. <!-- F277 F281 -->'],
  ['„Reikia apmokėti baudą“', 'Pareigūnai pinigų žmonių namuose nerenka. Nieko nemokėk, skambink 112. <!-- F277 -->'],
  ['Prisistato „pareigūnu“ ir rodo pažymėjimą', 'Pažymėjimo paprašyk, bet pinigų vis tiek neatiduok: pareigūnai jų namuose neima. Skambink 112. <!-- F277 M -->'],
  ['„Banko darbuotojas“ liepia išgryninti pinigus ir perduoti „kurjeriui“', 'Policija, bankai ar gydymo įstaigos to neprašo. Nutrauk pokalbį, o savo bankui skambink numeriu iš oficialios programėlės. <!-- F280 F13 -->'],
  ['Atvyksta pasiimti kortelės su PIN kodu', '„Luminor“ primena, kad bankai, policija ar kitos institucijos kortelių su PIN kodais neprašo, o SEB – kad niekada neprašo perduoti mokėjimo kortelių per tarpininkus ar kitus asmenis. <!-- F289 F288 -->'],
  ['„Aukso ekspertas“ ar „kurjeris“ prie durų', 'Policija neprašo pirkti aukso ir nesiunčia kurjerių pasiimti turto. <!-- F278 --> „Citadele“ įspėja, kad prie durų sukčiai prisistato kurjeriais ar tariamais aukso ekspertais, siūlo „įvertinti“ neva pelningą investiciją arba atvyksta paimti investavimui skirtų pinigų. <!-- F287 --> Aukso ar pinigų neatiduok. <!-- M -->'],
  ['„ESO“ darbuotojas atėjo keisti skaitiklio ar tikrinti elektros tinklo ir prašo sumokėti', 'ESO skaitiklius keičia nemokamai, namų elektros tinklo netikrina, apie darbus praneša iš anksto ir atsiskaityti čia ir dabar niekada neprašo. Nieko nemokėk ir neįsileisk; paskambink ESO numeriu iš eso.lt. <!-- F696 M -->'],
  ['Liepia nieko nesakyti artimiesiems', 'Policija nereikalauja slėpti informacijos nuo artimųjų. Pasitark su jais. <!-- F278 -->'],
];

const sources = [
  'Varėnos, Vilniaus 1-ojo komisariato ir Lietuvos policija (TV3, 2026-02-27, 2026-05-21, 2026-10-19): ką pareigūnai daro ir ko niekada nedaro namuose, du skambučiai ir vizitas, auksas. <!-- F277 F278 F279 -->',
  'Utenos policija (TV3, 2026-06-01; Utenos AVPK, 2017-10-24): „banko darbuotojas“, „kurjeris“, „padirbtų“ pinigų pretekstas. <!-- F280 F281 -->',
  'Klaipėdos prokuratūra (2024-02-06): skambinantys ir į namus atvykstantys bendrininkai. <!-- F282 -->',
  'LRT, iš policijos pranešimų (2026-05-08, 2026-07-10): trys atvejai. <!-- F283 -->',
  '„Citadele“ (TV3, 2026-05-27), SEB (2024-04-30) ir „Luminor“ (alkas.lt, 2024-05-20): kurjeriai ir „aukso ekspertai“, kortelės su PIN kodais. <!-- F287 F288 F289 -->',
  'ESO ir policija (alkas.lt, 2025-03-07): skaitikliai keičiami nemokamai, atsiskaityti vietoje neprašoma. <!-- F696 -->',
  'Kampanija „Padėk ragelį“, policija ir Lietuvos bankas: bankui iškart, policijai per epolicija.lt ar 112. <!-- F4 F2 F13 -->',
];
---
<Page
  title="„Pareigūnas“ prie durų: „padirbti“ pinigai – Suktas"
  description="Prie durų „pareigūnas“ ar „kurjeris“ sako, kad tavo pinigai padirbti ar reikia sumokėti baudą? Kaip tai atrodo, ką daryti prie durų ir jei jau atidavei."
  current="scenarijai"
>
  <article class="scn">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <h1>{title}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-11-07</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap" aria-labelledby="trumpai">
      <h2 id="trumpai" class="layer__title">Trumpai</h2>

      <div class="row">
        <h3>Kaip tai atrodo</h3>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Kai kuriais atvejais pirmiausia paskambinama. Vienas policijos pranešimas aprašo <a href="/scenarijai/skambutis-is-poliklinikos/">pirmąjį skambutį iš „poliklinikos“</a> ir antrąjį iš „policijos“: pastarasis reikalauja deklaruoti pajamas, o jei ne – grasina atvykti daryti kratos. <!-- F279 --> Kartais po „policijos“ prisistato „banko darbuotojas“, kuris liepia išsigryninti pinigus ir perduoti juos atvykusiam „kurjeriui“. <!-- F280 --> Tada kažkas pasibeldžia į duris. Varėnos policija aprašo, kad nepažįstamas žmogus prisistato policijos pareigūnu ir sako, kad tavo pinigai padirbti ir juos reikia patikrinti, arba prašo sumokėti baudą. <!-- F277 --> Kitais atvejais „kurjeris“ ateina pasiimti banko kortelės su PIN kodu <!-- F289 --> arba aukso, kurį žmogus buvo įkalbėtas nusipirkti. <!-- F278 --> Kartais prisistato ir „aukso ekspertas“, siūlo „įvertinti“ neva pelningą investiciją arba atvyksta paimti investavimui skirtų pinigų. <!-- F287 -->')} />
        </div>
      </div>

      <div class="row">
        <h3>Trys ženklai</h3>
        <ol class="row__body signs" role="list">
          {signs.map(([head, text]) => (
            <li><p><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></p></li>
          ))}
        </ol>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h3 id="ejimas">Tavo ėjimas</h3>
        <p class="move__line" set:html={nbHtml('Nieko neatiduok ir paskambink 112.')} />
        <p set:html={nbHtml('Neleisk skaičiuoti pinigų ar jų „tikrinti“, neatiduok pinigų, banko kortelės ar kitų vertybių ir paprašyk tarnybinio pažymėjimo. <!-- F277 --> Net jei pažymėjimą parodo, pinigų žmonių namuose pareigūnai neima, todėl atiduoti nereikia. <!-- F277 M --> Kilus įtarimų – skambink 112. <!-- F277 --> Nepažįstamų į namus neįsileisk, o pinigų per tarpininkus neperduok. <!-- F281 --> Papasakok tai ir artimiesiems, ypač vyresnio amžiaus. <!-- F277 -->')} />
      </section>

      <section class="box" aria-labelledby="padarei">
        <h3 id="padarei">Jei jau atidavei</h3>
        <p set:html={nbHtml('Jei atidavei kortelę – pirmiausia skambink savo bankui numeriu iš oficialios programėlės ar svetainės ir paprašyk ją užblokuoti. <!-- F13 F4 M --> Jei atidavei pinigus ar auksą – iškart skambink 112, o jei tai buvo anksčiau, pranešk per epolicija.lt. <!-- F277 F2 F4 --> Ar pinigus pavyks susigrąžinti, šaltiniai nesako, todėl pranešk kuo greičiau. <!-- M -->')} />
        <p set:html={nbHtml('Žingsniai: <a href="/jei-apgavo/#pinigai">Jei tave apgavo: išsiunčiau pinigus</a>, <a href="/jei-apgavo/#kortele">pasakiau kortelės duomenis</a>.')} />
      </section>

      <div class="cta">
        <a class="btn" href="/jei-apgavo/#pinigai">Jei jau atidavei</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Daiktų, kuriuos galima paimti iš rankų: grynųjų, kortelės su PIN kodu, aukso. <!-- F277 F289 F278 --> 2026 m. liepą LRT, remdamasi policija, rašė apie moterį Vilniuje: paskambinęs nepažįstamasis prisistatė policijos pareigūnu, o 8,5 tūkst. eurų ji atidavė atvykusiam nepažįstamam vyrui. Šiauliuose moteris į namus atvykusiam vyrui atidavė banko kortelę, nuo kurios buvo pasisavinti pinigai. <!-- F283 --> 2026 m. gegužę Raseiniuose moteriai paskambino nepažįstamasis, prisistatė policijos pareigūnu, pasakė, kad žentui nutiko nelaimė, ir pareikalavo pinigų; tą pačią dieną atvykęs vyras pagrobė jai iš rankų 10,5 tūkst. eurų. <!-- F283 --> <strong class="stop">Sustabdymo vieta:</strong> durys. Neįsileisk, pinigų prie durų neatnešk ir nieko neatiduok; atėjus jų pasiimti – 112. <!-- F281 F277 M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Byloje, kurią Klaipėdos prokurorai 2024 m. perdavė teismui, kaltinamieji skambino atsitiktiniams senjorams, o į namus atvykdavo laisvėje likę bendrininkai, įtikinėję, jog telefonu kalbėjo jie. <!-- F282 --> Antrasis skambutis „policijos“ vardu remiasi pirmuoju „poliklinikos“: sakoma, kad tave apgavo ir turi deklaruoti pajamas. <!-- F279 --> Kai kuriais atvejais jis iš anksto išvilioja ir gyvenamosios vietos adresą. <!-- F289 --> <strong class="stop">Sustabdymo vieta:</strong> telefonu nesakyk nei asmens duomenų, nei kodų, nei adreso. <!-- F279 M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jis naudoja tris iš penkių kabliukų, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>: <!-- M -->')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
            <p set:html={nbHtml('<strong class="stop">Sustabdymo vieta:</strong> nei pažymėjimas, nei prisistatymas neįrodo, kad jis tikras. Aišku tik tiek: policija pinigų žmonių namuose neima. <!-- F277 M -->')} />
            <p set:html={nbHtml('Toks pasiteisinimas nėra naujas: 2017 m. Utenos policija jau aprašė žmones, kurie prisistatė pareigūnais ir tikino, kad gyventojų pinigai padirbti, todėl atvažiuos jų patikrinti. <!-- F281 --> Tada Utenos policija priminė, kad pinigų netikrina ir su pinigais susijusių sandorių nevykdo – nieko neatiduok. <!-- F281 M -->')} />
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Kortelės:</strong> <a href="/sustok/padek-ragely/">{nb('Padėk ragelį ir skambink oficialiu numeriu')}</a>, <a href="/sustok/desimt-sekundziu/">{nb('Sustok dešimčiai sekundžių')}</a></li>
          <li><strong>Tema:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a></li>
          <li><strong>Kiti scenarijai:</strong> <a href="/scenarijai/skambutis-is-policijos/">{nb('Skambutis iš „policijos“')}</a>, <a href="/scenarijai/skambutis-is-banko/">{nb('Skambutis iš „banko“')}</a>, <a href="/scenarijai/artimojo-avarija/">{nb('„Tavo sūnus pateko į avariją“')}</a>, <a href="/scenarijai/skambutis-is-poliklinikos/">{nb('Skambutis iš „poliklinikos“')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-11-07. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
