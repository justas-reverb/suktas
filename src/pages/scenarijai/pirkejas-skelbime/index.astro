---
/**
 * Scenarijus: „Pirkėjas“ skelbime. The copy is docs/copy/scenarijai/pirkejas-skelbime.md,
 * word for word; the source tags stay as comments and the build strips them.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('„Pirkėjas“ skelbime');
const meta = [
  ['Kanalas', 'skelbimas'],
  ['Ko jis nori', 'kortelės duomenų ir prieigos prie banko'],
  ['Skaitymo laikas', '3 min.'],
];

const signs = [
  ['Kad gautum pinigus, reikia įvesti kortelės duomenis.', 'Lietuvos bankas sako, kad pinigams įskaityti į sąskaitą kortelės duomenys niekada nenaudojami. Tikram pirkėjui pakanka tavo sąskaitos numerio ir vardo. <!-- F148 F49 -->'],
  ['Kviečia išeiti iš platformos.', 'Nuoroda, SMS ar kita programėlė vietoj pokalbio portale. Vinted sako, kad mokėjimui patvirtinti ar užsakymui gauti Vinted palikti nereikia. <!-- F147 F149 F150 -->'],
  ['„Pagalba“, „kurjeris“ ar „platforma“ praneša, kad mokėjimas jau atliktas.', 'Skelbiu.lt pagalba per pokalbius į klientus nesikreipia ir atsiskaitant netarpininkauja; DPD nerenka mokėjimų už privačių asmenų parduodamas prekes. <!-- F151 F152 -->'],
];

const levers = [
  ['Nauda.', 'Tu lauki pirkėjo, o jis „jau sumokėjo“: žinutė apie pinigus skamba kaip gera naujiena, ne kaip pavojus. <!-- M F151 -->'],
  ['Autoritetas.', 'Žinutė ateina kurjerių bendrovės ar portalo „pagalbos“ vardu, pavyzdžiui, „skelbiu-supp0rt“. <!-- F147 F151 -->'],
  ['Skuba.', 'DPD įspėja, kad sukčių žinutėse dažnai kuriamas skubos jausmas. <!-- F152 --> <strong class="stop">Sustabdymo vieta:</strong> kuo gražiau skamba žinia apie pinigus, tuo ramiau ją patikrink ten, kur pinigai tikrai būtų: Vinted programėlėje ar savo banke. <!-- M F149 F151 -->'],
];

const sides = [
  ['„Pirkėjas“ siūlo susirašinėti SMS ar kita programėle', 'Rašyk tik platformoje: Vinted pataria nekelti pokalbio už jos ribų. <!-- F150 -->'],
  ['„Pinigai laukia paštomate“, „pirkėjas sumokėjo per kurjerį“', 'DPD nerenka mokėjimų už privačių asmenų parduodamas prekes. Mokėjimą tikrink Vinted programėlėje ar savo banke, ne per nuorodą. <!-- F152 F149 -->'],
  ['Pokalbyje rašo „pagalba“ ar „platforma“', 'Skelbiu.lt pagalba per pokalbius į klientus nesikreipia; Vinted laiškai ateina iš adreso, kuris baigiasi @vinted.lt. <!-- F151 F149 -->'],
  ['Forma prašo kortelės numerio, galiojimo datos ir CVV', 'Pinigams įskaityti kortelės duomenų nereikia; tikram pirkėjui pakanka sąskaitos numerio ir vardo. <!-- F148 F153 F49 -->'],
  ['Telefone pasirodo „Smart-ID“ užklausa', 'Tvirtink tik tai, ką pradėjai tu. <!-- F26 F147 -->'],
  ['Nuoroda atrodo kaip kurjerio', 'DPD adresai baigiasi dpd.lt, dpd.com arba dpdgroup.com, bet saugiausia nuorodos nespausti ir platformą atsidaryti savo rankomis. <!-- F152 F149 -->'],
  ['Sukčių svetainė veikia, kol jos neužblokuoja', 'Pranešk NKSC formoje „Pranešti apie svetainę“; greitesnis pranešimas leidžia anksčiau užblokuoti sukčių svetainę. <!-- F17 F21 -->'],
];

const sources = [
  'Lietuvos bankas, atnaujinta 2024-10-25: schema kurjerių bendrovių vardu; kontaktai iš skelbimų portalų; kortelės duomenys ir „Smart-ID“ PIN. <!-- F147 -->',
  'Lietuvos bankas, atnaujinta 2025-12-11: pinigams įskaityti kortelės duomenys niekada nenaudojami. <!-- F148 -->',
  'Vinted pagalba: platformos palikti nereikia, laiškai iš @vinted.lt, pokalbio nekelti už platformos ribų, pranešti apie sukčiavimą. <!-- F149 F150 -->',
  'TV3, 2025-07-05 (cituoja Skelbiu.lt vadovą): netikra „skelbiu-supp0rt“ žinutė; pagalba per pokalbius nesikreipia. <!-- F151 -->',
  'TV3, 2026-07-02 (DPD pranešimas): DPD nerenka mokėjimų už privačių asmenų prekes; oficialūs adresai; skuba. <!-- F152 -->',
  'Vilniaus apskrities policija, 2022-06-14: nuorodos, susijusios su Vinted, DPD, Skelbiu.lt ir LP Express, prašo kortelės duomenų. <!-- F153 -->',
  'TV3, 2024-03-19, ir ve.lt, 2026-03-25 (pagal policiją): du atvejai Klaipėdoje. <!-- F154 F155 -->',
  'Kampanija „Padėk ragelį“: tikram pirkėjui pakanka sąskaitos numerio ir vardo; po apgaulės – bankui. <!-- F49 F4 -->',
  'Lietuvos bankas, 2021-07-09: daryk tik tas operacijas, kurias pradėjai tu. <!-- F26 -->',
  'NKSC: pranešimo apie svetainę forma ir greitesnio pranešimo nauda. <!-- F17 F21 -->',
];
---
<Page
  title="„Pirkėjas“ Vinted ar Skelbiu: sukčių kurjerio nuoroda – Suktas"
  description="Kaip atrodo netikras pirkėjas, kuris „jau sumokėjo per kurjerį“, trys jo ženklai ir vienas ėjimas, kuris sustabdo planą."
  current="scenarijai"
>
  <article class="scn">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <h1>{title}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-10-30</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap" aria-labelledby="trumpai">
      <h2 id="trumpai" class="layer__title">Trumpai</h2>

      <div class="row">
        <h3>Kaip tai atrodo</h3>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Įkeli skelbimą apie parduodamą daiktą ir tau parašo „pirkėjas“. <!-- F147 --> Netrukus SMS ar pokalbių programėlėje ateina žinutė kurjerių bendrovės ar paties portalo vardu: pirkėjas „jau sumokėjo“ ir pinigus tereikia „gauti“. <!-- F147 F151 --> Nuoroda veda į svetainę, panašią į kurjerio, kurioje prašoma asmens ir kortelės duomenų, o paskui telefone gali pasirodyti „Smart-ID“ užklausa. <!-- F147 F153 --> Kartais „pirkėjas“ tiesiog prašo per atsiųstą nuorodą „užsakyti kurjerį“. <!-- F154 -->')} />
        </div>
      </div>

      <div class="row">
        <h3>Trys ženklai</h3>
        <ol class="row__body signs" role="list">
          {signs.map(([head, text]) => (
            <li><p><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></p></li>
          ))}
        </ol>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h3 id="ejimas">Tavo ėjimas</h3>
        <p class="move__line" set:html={nbHtml('Nespausk nuorodos.')} />
        <p set:html={nbHtml('Mokėjimą tikrink ten, kur jis tikrai būtų: Vinted – pačioje Vinted programėlėje, o kai atsiskaitoma tiesiogiai – savo banko programėlėje. Programėlę atsidaryk savo telefone arba adresą įvesk ranka. <!-- F149 F151 F26 M --> Pinigams gauti kortelės duomenų ir „Smart-ID“ PIN niekur neįvesk. <!-- F148 F147 --> Kortelė: <a href="/sustok/nuoroda-ne-is-zinutes/">Nespausk nuorodos – atsidaryk programėlę ar svetainę</a>.')} />
      </section>

      <section class="box" aria-labelledby="padarei">
        <h3 id="padarei">Jei jau prisigavai</h3>
        <p set:html={nbHtml('Jei jau įvedei kortelės ar banko duomenis arba patvirtinai „Smart-ID“ užklausą, pirmiausia skambink bankui. <!-- F4 M --> Apie sukčių pranešk ir platformai (Vinted tai prašo daryti per „Susisiek su mumis“). <!-- F149 M --> Žingsniai: <a href="/jei-apgavo/#kortele">Jei tave apgavo: pasakiau kortelės duomenis</a>.')} />
      </section>

      <div class="cta">
        <a class="btn" href="/sustok/nuoroda-ne-is-zinutes/">Atidaryk kortelę</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jam reikia tavo kortelės duomenų, o kartais – ir prisijungimo prie banko bei „Smart-ID“ PIN. <!-- F147 F153 F155 --> „Pirkėjas“ ir „apmokėjimas“ yra tik dingstis, kad nuorodą atidarytum tu. <!-- M --> 2024 m. kovą policija pranešė apie klaipėdietę, kuri pardavinėjo daiktą: „pirkėjo“ prašymu ji paspaudė atsiųstą nuorodą neva „kurjeriui užsakyti“, suvedė prašomus duomenis ir iš jos sąskaitos dingo 8 132 eurai. <!-- F154 --> 2026 m. kovą – apie kitą klaipėdietę, kuri paspaudė „pirkėjo“ nuorodą, suvedė asmens ir el. bankininkystės prisijungimo duomenis ir neteko 290 eurų. <!-- F155 --> <strong class="stop">Sustabdymo vieta:</strong> pinigams gauti kortelės duomenų nereikia, todėl forma, kuri jų prašo „išmokėjimui“, jau pati save išduoda. <!-- F148 -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Tik tai, kas matyti tavo skelbime: daiktą, kainą, kontaktą, kartais vardą ar miestą. <!-- M F147 --> Lietuvos bankas rašo, kad kontaktai gaunami iš skelbimų portalų ir prekybos ar mainų platformų. <!-- F147 --> Jis žino ir tai, kad tu nori parduoti, todėl žinutė apie pinigus neatrodo keista. <!-- M --> <strong class="stop">Sustabdymo vieta:</strong> kalbėkis platformos pokalbyje; kai „pirkėjas“ prašo pereiti į SMS ar kitą programėlę, tai jau ženklas. Vinted taip ir pataria. <!-- F150 -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Veikia trys kabliukai, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>:')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Kortelės:</strong> <a href="/sustok/nuoroda-ne-is-zinutes/">{nb('Nespausk nuorodos – atsidaryk programėlę ar svetainę')}</a>, <a href="/sustok/kodai-ir-pin/">{nb('Kodų ir PIN niekam nesakyk')}</a></li>
          <li><strong>Tema:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a></li>
          <li><strong>Kiti scenarijai:</strong> <a href="/scenarijai/netikras-pardavejas/">{nb('„Pardavėjas“ prašo avanso')}</a>, <a href="/scenarijai/zinute-su-nuoroda/">{nb('Žinutė su nuoroda')}</a>, <a href="/scenarijai/zinute-su-kodu/">{nb('Žinutė su kodu')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-10-30. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
