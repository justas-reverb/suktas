---
/**
 * Scenarijus: Reklama su žinomu veidu. The copy is docs/copy/scenarijai/reklama-su-zinomu-veidu.md,
 * word for word.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('Reklama su žinomu veidu');
const meta = [
  ['Kanalas', 'reklama'],
  ['Ko jis nori', 'pinigų „investicijai“, o vėliau – dar kartą'],
  ['Skaitymo laikas', '3 min.'],
];

const signs = [
  ['Žinomas veidas rekomenduoja investuoti.', 'Lietuvos bankas perspėja apie netikras reklamas, kuriose naudojami garsūs pramogų pasaulio veidai ir žinomi valstybės institucijų vadovai. <!-- F50 --> Toks vaizdo įrašas gali būti sukurtas dirbtiniu intelektu: „Debunk.org“ vadovas Viktoras Daukšas sako, kad jie kartais per savaitę užfiksuoja 500–700 tokių atvejų, ir juose būna Lietuvoje gerai žinomų žurnalistų bei politikų veidų. <!-- F748 --> Tikras ar sukurtas, žinomas veidas investicijų reklamoje nieko neįrodo. <!-- M -->'],
  ['Puslapis atrodo kaip naujienų portalas.', 'Lietuvos bankas sako, kad sukčiai imituoja naujienų portalus. <!-- F50 -->'],
  ['Po to skambina ar rašo „teisininkai“ ar „gelbėtojai“ ir siūlo susigrąžinti pinigus už 10–50 % sumos.', 'Lietuvos bankas ir Bankų asociacija įspėja, kad tai antras apgavimas. <!-- F14 F15 F16 -->'],
];

const levers = [
  ['Autoritetas.', 'Žinomo veido ir naujienų portalo išvaizda skolinasi pasitikėjimą, kurio sukčius neturi. <!-- F50 M -->'],
  ['Nauda.', 'Investicinis pažadas vilioja pelnu, todėl žmogus pradeda skaičiuoti, o ne abejoti. <!-- F23 M -->'],
  ['Gėda ir baimė (vėliau).', 'Po nuostolio norisi viską atgauti ir apie tai niekam nesakyti – tuo ir remiasi antras apgavimas. <!-- M -->'],
];

const sides = [
  ['Žinomo veido rekomendacija', 'Tai ne įrodymas: Lietuvos bankas perspėja, kad sukčiai tokias reklamas daro naudodami garsius veidus. <!-- F50 -->'],
  ['Puslapis, panašus į naujienų portalą', 'Vien išvaizdos panašumas nieko neįrodo. <!-- F50 M -->'],
  ['„Nemokama“ investavimo grupė, kviečianti žinomos organizacijos vardu', 'Organizacijos vardas ar profilis socialiniame tinkle neįrodo, kas už jų stovi: Bankų asociacija sako tokių grupių nevaldanti. <!-- F103 M -->'],
  ['Didelės grąžos be rizikos pažadas', 'Lietuvos bankas: „Didelės grąžos be rizikos nebūna.“ <!-- F104 -->'],
  ['„Investicija“, mokėjimas kortele', '„Mastercard“ ir „Visa“ grąžinimo schemos investicijų nuostolių neapima, todėl sustoti reikia prieš siunčiant pinigus. <!-- F14 -->'],
  ['„Teisininkai“ ar „gelbėtojai“ siūlo susigrąžinti pinigus už mokestį', 'Nemokėk: tai antras apgavimas. <!-- F14 F15 F16 -->'],
  ['Skambina „institucija“, kuri esą tiria sukčių tinklą', 'Ir ji siūlo susigrąžinti pinigus už mokestį; tai tas pats triukas. <!-- F16 -->'],
];

const sources = [
  'Lietuvos bankas, atnaujinta 2024-10-28: netikros reklamos su žinomais veidais; „susigrąžinimo“ pasiūlymai už 10–50 %; kortelių grąžinimo schemos. <!-- F14 F50 -->',
  'Lietuvos bankas, 2020-02-12: „gelbėtojai“, siūlantys susigrąžinti pinigus už mokestį. <!-- F15 -->',
  'Bankų asociacija, 2022-10-27: vėliau skambinantys „institucijų“ vardu. <!-- F16 -->',
  'Kampanija „Padėk ragelį“: investiciniai pažadai kaip viena iš schemų. <!-- F23 -->',
  'Lietuvos bankas, 2021-07-09: operacijas daryti tik oficialioje programėlėje ir tik tas, kurias pradėjai tu. <!-- F26 -->',
  'Lietuvos bankų asociacija, 2026-10-08: netikras jos profilis ir „nemokama“ „WhatsApp“ grupė apie akcijas ir ETF. <!-- F103 -->',
  'Lietuvos bankas, 2026-04-14: pensijų lėšas gaunantys žmonės kaip investicinio sukčiavimo taikiniai; „Didelės grąžos be rizikos nebūna.“ <!-- F104 -->',
  '„Swedbank“ ir „Debunk.org“, 2026-01-22: dirbtiniu intelektu sukurti vaizdo įrašai su žinomais veidais. <!-- F748 -->',
  'Lietuvos bankų asociacija, 2023-12-15: reklama, nuvedanti į „Telegram“ grupes. <!-- F740 -->',
];
---
<Page
  title="Investavimo reklama su žinomu veidu: sukčių apgaulė – Suktas"
  description="Kaip atrodo netikra investavimo reklama su žinomu veidu, trys jos ženklai ir vienas ėjimas, kuris sustabdo planą."
  current="scenarijai"
>
  <article class="scn">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <h1>{title}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-10-25</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap" aria-labelledby="trumpai">
      <h2 id="trumpai" class="layer__title">Trumpai</h2>

      <div class="row">
        <h3>Kaip tai atrodo</h3>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Naršai ar skaitai naujienas – ir pasirodo reklama: žinomas pramogų pasaulio veidas ar valstybės institucijos vadovas, atrodo, rekomenduoja investuoti. <!-- F50 --> Spusteli ir patenki į puslapį, kuris išvaizda primena naujienų portalą. <!-- F50 --> Tokia reklama žada investicinį pelną; kampanija „Padėk ragelį“ šią schemą vadina investiciniais pažadais. <!-- F23 --> Kvietimas gali ateiti ir kitu būdu: 2026 m. spalį Lietuvos bankų asociacija perspėjo apie netikrą savo „Facebook“ profilį, kuris kviečia į „nemokamą“ „WhatsApp“ grupę apie akcijas ir ETF. <!-- F103 --> Asociacija tokių grupių nevaldo ir apie profilį pranešė „Meta“, policijai ir NKSC. <!-- F103 --> Kita reklama nuveda į „Telegram“ grupę: <a href="/scenarijai/investicijos-telegram/">Reklama kviečia į „Telegram“, o ten auga „pelnas“</a>. <!-- F740 -->')} />
        </div>
      </div>

      <div class="row">
        <h3>Trys ženklai</h3>
        <ol class="row__body signs" role="list">
          {signs.map(([head, text]) => (
            <li><p><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></p></li>
          ))}
        </ol>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h3 id="ejimas">Tavo ėjimas</h3>
        <p class="move__line" set:html={nbHtml('Reklamos nespausk ir pinigų pagal ją nesiųsk.')} />
        <p set:html={nbHtml('Jei nori investuoti, atsidaryk paslaugą tiesiogiai, o ne per reklamą, ir prieš tai sustok dešimčiai sekundžių. <!-- F26 M --> Kortelės: <a href="/sustok/nuoroda-ne-is-zinutes/">Nespausk nuorodos – atsidaryk programėlę ar svetainę</a>, <a href="/sustok/desimt-sekundziu/">Sustok dešimčiai sekundžių</a>.')} />
        <p set:html={nbHtml('Ar bendrovė turi leidimą teikti investicines paslaugas, patikrink <a href="https://www.lb.lt/lt/finansu-rinku-dalyviai">Lietuvos banko finansų rinkos dalyvių sąraše</a>. <!-- F118 --> Lietuvos bankas skelbia ir perspėjimus investuotojams bei blokuojamų nelegalių svetainių sąrašą, bet jei bendrovės tame sąraše nėra, tai dar neįrodo, kad ji patikima. <!-- F118 M -->')} />
      </section>

      <section class="box" aria-labelledby="padarei">
        <h3 id="padarei">Jei jau prisigavai</h3>
        <p set:html={nbHtml('Jei jau pervedei pinigus ar palikai duomenis, skambink bankui, o jei kas nors siūlo pinigus susigrąžinti už mokestį, nemokėk: <a href="/jei-apgavo/#pinigai">Jei tave apgavo: išsiunčiau pinigus</a>.')} />
      </section>

      <div class="cta">
        <a class="btn" href="/sustok/nuoroda-ne-is-zinutes/">Atidaryk kortelę</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Sukčiui reikia, kad pinigus į „investiciją“ pervestum tu. <!-- F23 M --> O kai pinigai jau pervesti, jam reikia antro apgavimo: Lietuvos bankas rašo, kad tie, kurie jau turi nukentėjusiojo duomenis, dažnai apsimeta teisininkais ir siūlo pinigus „susigrąžinti“. <!-- F14 --> Vienas taikinių – žmonės, kurie dabar gauna antrosios pakopos pensijų lėšas: Lietuvos bankas 2026 m. balandį perspėjo, kad jie tampa investicinio sukčiavimo ir netikrų teisininkų taikiniais. <!-- F104 --> <strong class="stop">Sustabdymo vieta:</strong> pinigų nesiųsk niekam, ką radai per reklamą; o jei jau siuntei, už „susigrąžinimą“ nemokėk. <!-- F14 F15 -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Iš reklamos – nieko; ji rodoma daugeliui. <!-- M --> Viskas, ką palieki puslapyje, tampa jo žiniomis, o tie, kurie jau turi nukentėjusiojo duomenis, vėliau jais naudojasi. <!-- M F14 --> <strong class="stop">Sustabdymo vieta:</strong> nepalik duomenų puslapyje, į kurį atvedė reklama.')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Veikia kabliukai, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>:')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Kortelės:</strong> <a href="/sustok/nuoroda-ne-is-zinutes/">{nb('Nespausk nuorodos – atsidaryk programėlę ar svetainę')}</a>, <a href="/sustok/desimt-sekundziu/">{nb('Sustok dešimčiai sekundžių')}</a></li>
          <li><strong>Tema:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a></li>
          <li><strong>Kiti scenarijai:</strong> <a href="/scenarijai/zinute-su-nuoroda/">{nb('Žinutė su nuoroda')}</a>, <a href="/scenarijai/skambutis-is-policijos/">{nb('Skambutis iš „policijos“')}</a>, <a href="/scenarijai/padesime-atsiimti-pensija/">{nb('„Padėsime atsiimti pensiją“')}</a>, <a href="/scenarijai/netikras-brokeris/">{nb('Užpildei formą, o skambina „brokeris“')}</a>, <a href="/scenarijai/prekybos-kursai-ir-signalai/">{nb('Prekybos kursai ir signalai už pinigus')}</a>, <a href="/scenarijai/investicijos-telegram/">{nb('Reklama kviečia į „Telegram“, o ten auga „pelnas“')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-10-25. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
