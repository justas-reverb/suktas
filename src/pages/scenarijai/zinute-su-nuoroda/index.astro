---
/**
 * Scenarijus: Žinutė su nuoroda. The copy is docs/copy/scenarijai/zinute-su-nuoroda.md,
 * word for word; the source tags stay as comments and the build strips them.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('Žinutė su nuoroda');
const meta = [
  ['Kanalas', 'žinutė'],
  ['Ko jis nori', 'kortelės ir prisijungimo duomenų'],
  ['Skaitymo laikas', '3 min.'],
];

const signs = [
  ['Nuoroda ir „mokestis“.', 'Lietuvos paštas sako, kad tikros jo žinutės neturi tiesioginės mokėjimo nuorodos ir neprašo kortelės duomenų; „Omniva“ – kad kortelės duomenų niekada neprašo. <!-- F44 F45 --> DPD sako, kad siuntiniui sekti ar pristatyti kortelės duomenų nereikia. <!-- F100 --> Už tikras Lietuvos pašto paslaugas mokama tik prisijungus prie jo savitarnos, kurią atsidarai savo rankomis, ne iš žinutės nuorodos. <!-- F162 M -->'],
  ['Skubinimas ar grasinimas.', '„Paskyra bus užblokuota“, „būtina patvirtinti“. <!-- F24 F26 -->'],
  ['Prašo kortelės duomenų arba siūlo per nuorodą gauti „siuntinio PIN“.', '<!-- F44 F45 --> Tikram pirkėjui skelbime pakanka tavo sąskaitos numerio ir vardo, o ne kortelės duomenų. <!-- F49 -->'],
];

const levers = [
  ['Skuba ir baimė.', '„Paskyra bus užblokuota“ ir „būtina patvirtinti“ skatina spausti, o ne tikrinti. <!-- F24 -->'],
  ['Autoritetas.', 'Sukčiai prisidengia Lietuvos pašto, DPD ar „Omnivos“ vardu. <!-- F44 F45 F100 -->'],
  ['Nauda.', '„Pirkėjas“, kuris „sumokės už prekę“, žada pinigus, o prašo tik „užpildyti anketą“. <!-- F24 F49 -->'],
];

const sides = [
  ['Nuoroda žinutėje', 'Nespausk; atsidaryk programėlę ar įvesk adresą savo rankomis. <!-- F26 -->'],
  ['„Mokestis“ ir kortelės forma', 'Lietuvos paštas ir „Omniva“ kortelės duomenų neprašo. <!-- F44 F45 -->'],
  ['„Siuntinio PIN“ nuoroda', '„Omnivos“ oficialūs adresai: omniva.ee, omniva.lv, omniva.lt. <!-- F45 -->'],
  ['Žinutė iš paprasto telefono numerio', 'Tikrose Lietuvos pašto ir LP EXPRESS žinutėse vietoje numerio matyti LPASTAS arba LP_EXPRESS. <!-- F162 --> Bet siuntėjo vardas dar nieko neįrodo: ir žinutės nuo LPASTAS nuorodos nespausk. <!-- M -->'],
  ['Puslapis, panašus į DPD', 'Oficialių DPD puslapių adresai baigiasi dpd.lt, dpd.com arba dpdgroup.com. <!-- F100 F163 --> Tačiau panašų adresą užregistruoti nesunku, todėl DPD svetainę ar programėlę atsidaryk savo rankomis, ne iš žinutės. <!-- F26 M --> Pirmiausia patikrink DPD siuntų sekimo programėlę: jei ten nėra jokios siuntos, ko gero, rašo sukčiai. <!-- F100 --> O jei siunta ten yra, tvarkyk ją programėlėje, ne per žinutės nuorodą. <!-- M --> Įspėti turėtų ir daug klaidų tekste, iškraipytas ar senasis DPD logotipas. <!-- F163 --> Bet ir be klaidų parašyta žinutė gali būti sukčių. <!-- M -->'],
  ['Žinutė ar skambutis „Sodros“ vardu', '„Sodra“ sako, kad kiekviena tikra žinutė matoma ir tavo „Sodros“ paskyroje, o jos darbuotojai telefonu asmens kodo neprašo. <!-- F47 --> Dokumentus „Sodra“ siunčia tik registruotais laiškais per Lietuvos paštą arba „Samus“. <!-- F102 --> Skambina „Omnivos kurjeris“ su „Sodros laišku“ ir prašo asmens kodo – baik pokalbį, susisiek su „Sodra“ ir pranešk policijai. <!-- F102 -->'],
  ['Žinutė Registrų centro, banko, policijos, VMI ar „Sodros“ vardu', '2026 m. gegužę, kai galėjo būti nukopijuota daugiau nei 600 000 Nekilnojamojo turto ir Juridinių asmenų registrų įrašų, Valstybinė duomenų apsaugos inspekcija (VDAI) perspėjo, kad sukčiai gali apsimesti šiomis įstaigomis. <!-- F105 --> Informaciją tikrink tik oficialiuose šaltiniuose ir nespausk nuorodų SMS ar laiškuose. <!-- F105 -->'],
  ['„Pirkėjas“ prašo kortelės duomenų', 'Tikram pirkėjui pakanka sąskaitos numerio ir vardo. <!-- F49 -->'],
  ['Bendrovė nežino, kad jos vardu siunčiamos žinutės', 'Pranešk bendrovei: Lietuvos paštui – prevencija@post.lt, DPD – kas@dpd.lt, „Omnivai“ – per jos klientų aptarnavimo centrą. <!-- F162 F100 F45 -->'],
  ['Sukčių svetainė veikia, kol niekas nepraneša', 'Pranešk NKSC: apie svetainę formoje „Pranešti apie svetainę“, apie žinutę – formoje „Pranešti apie žinutę / skambutį“; greitesnis pranešimas leidžia anksčiau užblokuoti sukčių svetainę. <!-- F17 F18 F21 -->'],
];

const sources = [
  'Kampanija „Padėk ragelį“: frazės, kurias vartoja „bankas“ ir „pirkėjas“; pirkėjo schema. <!-- F24 F49 -->',
  'Lietuvos bankas, 2021-07-09: ignoruoti skubius SMS ar laiškus su nuorodomis; operacijas daryti oficialioje programėlėje. <!-- F26 -->',
  'Lietuvos paštas, 2022-06-14, ir „Omniva“, 2025-08-30: netikros žinutės apie siuntinius. <!-- F44 F45 -->',
  'Lietuvos paštas, 2025-10-28: siuntėjas LPASTAS ar LP_EXPRESS, mokėjimai tik savitarnoje, prevencija@post.lt. <!-- F162 -->',
  '„Sodra“, 2025-11-07: tikros žinutės matomos paskyroje. <!-- F47 -->',
  'LRT, 2026-10-20 (cituoja „Sodrą“): skambutis „Omnivos kurjerio“ vardu dėl „Sodros laiško“; dokumentų siuntimo būdai. <!-- F102 -->',
  'LRT, 2026-07-02 (cituoja DPD ir RRT): žinutės apie sulaikytą siuntinį; kortelės duomenų nereikia; oficialūs adresai ir kas@dpd.lt. <!-- F100 -->',
  'DPD: kaip atpažinti sukčiavimą (adresas, klaidos, logotipas). <!-- F163 -->',
  'LRT, 2026-05-23: Registrų centro duomenų nutekėjimas ir VDAI perspėjimas. <!-- F105 -->',
  'LRT ir ELTA, 2026-08-01 (cituoja Pinigų plovimo prevencijos kompetencijų centrą): 2026 m. antrojo ketvirčio atvejai, apie 41 % – SMS ar laiškai. <!-- F109 -->',
  'RRT, 2026-08-10: užblokuoti SMS ir pokalbių programėlės. <!-- F39 -->',
  'NKSC: pranešimo formos ir greitesnio pranešimo nauda. <!-- F17 F18 F21 -->',
];
---
<Page
  title="SMS sukčiai apie siuntinį: „Omniva“, DPD, LP EXPRESS – Suktas"
  description="Kaip atrodo netikra žinutė apie siuntinį ar „mokestį“ „Omnivos“, DPD ar Lietuvos pašto vardu, trys jos ženklai ir vienas ėjimas, kuris sustabdo planą."
  current="scenarijai"
>
  <article class="scn">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <h1>{title}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-10-25</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap" aria-labelledby="trumpai">
      <h2 id="trumpai" class="layer__title">Trumpai</h2>

      <div class="row">
        <h3>Kaip tai atrodo</h3>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Telefone pasirodo SMS, laiškas ar žinutė pokalbių programėlėje. <!-- F39 --> Joje rašoma, kad laukia siuntinys ir reikia sumokėti nedidelį „mokestį“, kad „būtina patvirtinti“ duomenis arba kad „paskyra bus užblokuota“. <!-- F24 F44 F45 --> Nuoroda veda į formą, kurioje prašoma kortelės duomenų. <!-- F44 --> Pavyzdžiui, DPD vardu masiškai siunčiamose žinutėse rašoma, kad siuntinys sulaikytas terminale. <!-- F100 --> Kartais ta pati istorija tęsiasi skambučiu: LRT 2026 m. spalį rašė, kad skambinantys prisistato „Omnivos“ kurjeriais, esą turi „Sodros“ laišką ir prašo asmens kodo. <!-- F102 --> Panaši schema ir skelbimuose: „pirkėjas“ sako, kad atvažiuos kurjeris ir sumokės už prekę – tereikia užpildyti anketą. <!-- F24 F49 -->')} />
        </div>
      </div>

      <div class="row">
        <h3>Trys ženklai</h3>
        <ol class="row__body signs" role="list">
          {signs.map(([head, text]) => (
            <li><p><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></p></li>
          ))}
        </ol>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h3 id="ejimas">Tavo ėjimas</h3>
        <p class="move__line" set:html={nbHtml('Nespausk nuorodos.')} />
        <p set:html={nbHtml('Atsidaryk paslaugos programėlę arba įvesk jos adresą naršyklėje ir patikrink ten. Oficialioje programėlėje ar svetainėje daryk tik tas operacijas, kurias pradėjai tu. <!-- F26 --> Kortelė: <a href="/sustok/nuoroda-ne-is-zinutes/">Nespausk nuorodos – atsidaryk programėlę ar svetainę</a>.')} />
      </section>

      <section class="box" aria-labelledby="padarei">
        <h3 id="padarei">Jei jau prisigavai</h3>
        <p set:html={nbHtml('Jei jau paspaudei nuorodą ir įvedei kortelės ar prisijungimo duomenis, skambink bankui. Žingsniai: <a href="/jei-apgavo/#kortele">Jei tave apgavo: pasakiau kortelės duomenis</a>.')} />
      </section>

      <div class="cta">
        <a class="btn" href="/sustok/nuoroda-ne-is-zinutes/">Atidaryk kortelę</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Sukčiui reikia kortelės ar prisijungimo duomenų, kuriuos tu įvestum savo rankomis. <!-- F44 F45 --> „Mokestis“ yra tik priedanga, kad forma atrodytų būtina. <!-- M --> <strong class="stop">Sustabdymo vieta:</strong> tikros siuntų bendrovės kortelės duomenų neprašo, todėl pats prašymas yra ženklas sustoti. <!-- F44 F45 -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Beveik nieko. <!-- M --> Žinučių siunčiama labai daug: vien 2026 m. antrąjį ketvirtį operatoriai užblokavo 1,22 mln. sukčiavimo SMS. <!-- F39 --> Tai nėra retenybė: pasak LRT ir ELTA, remiantis Pinigų plovimo prevencijos kompetencijų centro duomenimis, tą patį ketvirtį užregistruota 3 718 sukčiavimo atvejų, o apie 41 % (1 514) iš jų buvo sukčiavimas SMS ar el. laiškais. <!-- F109 --> Sukčiui užtenka, kad kuriam nors iš gavėjų žinutė pasirodytų įtikinama. <!-- M --> <strong class="stop">Sustabdymo vieta:</strong> jei nieko neužsakei ir nepradėjai jokios operacijos, tokiai žinutei nėra jokio pagrindo.')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Veikia keli kabliukai, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>:')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Kortelės:</strong> <a href="/sustok/nuoroda-ne-is-zinutes/">{nb('Nespausk nuorodos – atsidaryk programėlę ar svetainę')}</a>, <a href="/sustok/desimt-sekundziu/">{nb('Sustok dešimčiai sekundžių')}</a></li>
          <li><strong>Tema:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a></li>
          <li><strong>Kiti scenarijai:</strong> <a href="/scenarijai/skambutis-is-banko/">{nb('Skambutis iš „banko“')}</a>, <a href="/scenarijai/reklama-su-zinomu-veidu/">{nb('Reklama su žinomu veidu')}</a></li>
          <li><strong>Žodynas:</strong> <a href="/zodynas/phishing/">{nb('Kas yra phishing')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-10-25. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
