---
/**
 * Scenarijus: „Pardavėjas“ prašo avanso. The copy is docs/copy/scenarijai/netikras-pardavejas.md,
 * word for word; the source tags stay as comments and the build strips them.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('„Pardavėjas“ prašo avanso');
const meta = [
  ['Kanalas', 'skelbimas'],
  ['Ko jis nori', 'tavo pinigų už daiktą, kurio nėra'],
  ['Skaitymo laikas', '3 min.'],
];

const signs = [
  ['Prašo pinigų, kol daikto nematei.', 'Avansas, užstatas ar „rezervacija“ prieš apžiūrą. Policija pataria nepervesti avanso ar užstato, kol prekės nematei. <!-- F262 F263 -->'],
  ['Kviečia mokėti ne per platformą.', 'Pavedimu tiesiai į sąskaitą arba per atsiųstą nuorodą, o susirašinėti siūlo „WhatsApp“ ar „Viber“. „Vinted“ sako, kad mokėjimui patvirtinti ar prekei gauti iš platformos išeiti ar spausti nuorodų nereikia. <!-- F260 F270 F269 -->'],
  ['Kaina per gera, o laiko mažai.', 'Policija įspėja, kad itin žema kaina gali pranašauti pavojų, o „kitas pirkėjas laukia“ – tai jo būdas neleisti tau pagalvoti. <!-- F262 F263 M -->'],
];

const steps = [
  '<strong>Skambink savo bankui</strong> numeriu iš oficialios programėlės ar svetainės ir prašyk sustabdyti pavedimą: kuo greičiau veiki, tuo didesnė tikimybė pinigus atgauti. <!-- F4 F203 -->',
  '<strong>Suvedei kortelės ar banko duomenis nuorodoje?</strong> Pasakyk tai bankui tame pačiame skambutyje ir paprašyk užblokuoti kortelę. <!-- F4 -->',
  '<strong>Išsaugok susirašinėjimą</strong>, skelbimą ir sąskaitos, į kurią pervedei, numerį. <!-- F4 M -->',
  '<strong>Pranešk policijai</strong> per epolicija.lt, net jei suma nedidelė: sukčiui gresia atsakomybė ir už mažą žalą. <!-- F2 F261 --> Tai apgaulė, ne vartotojų ginčas: perkant iš privataus asmens vartotojų teisės paprastai netaikomos. <!-- F275 F271 -->',
  '<strong>Pranešk platformai</strong>, kurioje radai skelbimą. <!-- F272 F149 -->',
];

const levers = [
  ['Nauda.', 'Daiktas pigiau nei kitur priverčia skaičiuoti, kiek sutaupysi, o ne abejoti. <!-- F262 F263 M -->'],
  ['Skuba.', '„Jau ne vienas pirkėjas laukia eilėje“ – ir avansas atrodo kaip vienintelis būdas daiktą išsaugoti. <!-- F263 -->'],
  ['Autoritetas.', 'Kartais jis prisidengia įmonės vardu ir pasirašo „rankpinigių sutartį“: 2026 m. vasarį Klaipėdos apskrities policija perdavė teismui bylą, kurioje vyras kaltinamas, kad, internete siūlydamas automobilius ir jų dalis, iš septynių žmonių išviliojo 8,6 tūkst. eurų, o su automobilių pirkėjais pasirašydavo rankpinigių sutartis. <!-- F267 -->'],
];

const sides = [
  ['„Vinted“: „neturiu mygtuko „Pirkti“, pervesk tiesiai“', 'Pirk tik per „Vinted“ pirkimo funkciją; pinigų tiesiai į pardavėjo sąskaitą nesiųsk. <!-- F260 -->'],
  ['„Kitas pirkėjas laukia, pervesk avansą, kad rezervuočiau“', 'Avanso ar užstato nepervesk, kol daikto nematei. <!-- F262 F263 -->'],
  ['Kaina gerokai mažesnė nei kitur', 'Itin žema kaina gali pranašauti pavojų: nemokėk, kol daikto nematei. <!-- F262 -->'],
  ['Siūlo susirašinėti „WhatsApp“ ar „Viber“', 'Kalbėkis platformos pokalbyje: sukčiai neretai kontaktuoja per susirašinėjimo programėles. <!-- F270 F150 -->'],
  ['Atsiunčia neva siuntų tarnybos nuorodą', 'Nespausk. „Vinted“ sako, kad mokėjimui patvirtinti ar prekei gauti spausti jokių nuorodų nereikia; mokėk tik pačios platformos pirkimo mygtuku. <!-- F269 F260 F271 -->'],
  ['Rodo įmonės vardą, siūlo pasirašyti sutartį', 'Sutartis nėra įrodymas. Automobilio pardavėjui pinigų nepervesk, kol nesusitikai ir neapžiūrėjai automobilio. <!-- F267 F272 -->'],
  ['Profilis naujas, mažai draugų ir įrašų', 'Tai gali būti apgaviko ženklas: nemokėk, kol daikto nematei. <!-- F274 F262 -->'],
  ['Atsiskaityti už „Skelbiu.lt“ užsakymą siūlo už platformos ribų', 'Taisyklės to neleidžia, o už tokius nuostolius platforma neatsako. <!-- F271 -->'],
];

const sources = [
  'Ukmergės r. policija ir „Vinted“ (TV3, 2026-10-09): „nėra mygtuko „Pirkti““, pavedimas tiesiai, pirkti tik per platformą. <!-- F260 -->',
  'Klaipėdos ir Vilniaus apskričių policija (2020–2021): pardavėjas dingsta po pavedimo, avansas ir užstatas prieš apžiūrą, skuba, svetimos sąskaitos, pranešti ir apie mažą sumą. <!-- F261 F262 F263 -->',
  'Tauragės apskrities policija (2026-07-21, 2026-10-19, 2026-10-20): atvejai Šilutėje ir jos apylinkėse. <!-- F264 F265 F266 -->',
  'Klaipėdos apskrities policija (TV3, 2026-02-26): byla dėl rankpinigių sutarčių ir avansų už automobilius perduota teismui. <!-- F267 -->',
  'Bankų asociacija, atpazinksukciu.lt: netikros siuntų tarnybų nuorodos perkant ir parduodant. <!-- F269 -->',
  '„Skelbiu.lt“ (2021-01-26) ir jos „Pirkti dabar“ taisyklės (atnaujintos 2026-09-30). <!-- F270 F271 -->',
  '„Autoplius“ (TV3, 2023-04-15) ir „Citadele“ (LRT, 2025-04-07). <!-- F272 F274 -->',
  '„Vinted“ pagalba: pirkimas mygtuku „Pirkti“ apsaugotas, jei siunta neatkeliauja. <!-- F150 -->',
  'VVTAT (2021) ir „Skelbiu.lt“ taisyklės (2026): perkant iš privataus asmens vartotojų teisės paprastai netaikomos. <!-- F275 F271 -->',
  'Kampanija „Padėk ragelį“, policija, „Luminor“ (LRT, 2025-11-02) ir „Vinted“ pagalba: bankui iškart, policijai per epolicija.lt, platformai. <!-- F4 F2 F203 F149 -->',
];
---
<Page
  title="„Pardavėjas“ prašo avanso: Vinted, Skelbiu.lt, Facebook – Suktas"
  description="Daiktas pigiai, „kitas pirkėjas jau laukia“, o pinigus reikia pervesti iš anksto? Kaip atpažinti netikrą pardavėją ir ką daryti, jei jau sumokėjai."
  current="scenarijai"
>
  <article class="scn">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <h1>{title}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-11-01</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap" aria-labelledby="trumpai">
      <h2 id="trumpai" class="layer__title">Trumpai</h2>

      <div class="row">
        <h3>Kaip tai atrodo</h3>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Skelbimų portale, „Vinted“ ar „Facebook“ tinkle randi daiktą ar automobilį pigiau nei kitur. <!-- F263 F265 F266 --> „Pardavėjas“ skubina: kitas pirkėjas jau laukia, tad daiktą jis „rezervuos“ tik gavęs avansą ar užstatą. <!-- F263 F262 --> „Vinted“ platformoje jis sako, kad mygtuko „Pirkti“ nėra, ir prašo pervesti pinigus tiesiai į jo sąskaitą. <!-- F260 --> Po pavedimo jis dingsta, o daikto nesulauki. <!-- F260 F261 F262 --> Kartais vietoj sąskaitos numerio jis atsiunčia neva siuntų tarnybos nuorodą, kurioje prašoma kortelės ar interneto banko duomenų. <!-- F269 -->')} />
        </div>
      </div>

      <div class="row">
        <h3>Trys ženklai</h3>
        <ol class="row__body signs" role="list">
          {signs.map(([head, text]) => (
            <li><p><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></p></li>
          ))}
        </ol>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h3 id="ejimas">Tavo ėjimas</h3>
        <p class="move__line" set:html={nbHtml('Nemokėk, kol daikto nematei, arba mokėk tik per pačią platformą.')} />
        <p set:html={nbHtml('Daiktą apžiūrėk gyvai ir mokėk tik tada. <!-- F262 M --> „Autoplius“ automobilių pirkėjams kategoriškai rekomenduoja nepervesti pinigų, kol nesusitikai ir neapžiūrėjai automobilio. <!-- F272 --> „Vinted“ platformoje pirk tik mygtuku „Pirkti“: toks pirkimas apsaugotas, jei siunta neatkeliauja. <!-- F150 F260 --> „Skelbiu.lt“ – per „Pirkti dabar“: sumokėti pinigai laikomi mokėjimo platformoje, kol sandoris baigiamas. <!-- F271 --> Pinigų tiesiai į pardavėjo sąskaitą nesiųsk, net jei jis prašo, ir jo atsiųstų nuorodų nespausk. <!-- F260 F269 -->')} />
      </section>

      <section class="box" aria-labelledby="padarei">
        <h3 id="padarei">Jei jau sumokėjai</h3>
        <p set:html={nbHtml('Tai gali nutikti bet kam: 2026 m. vien Šilutės rajone policija pranešė apie žmones, praradusius 260, 427, 1 000 ir 6 250 eurų. <!-- F264 F265 F266 --> Veik iškart:')} />
        <ol>
          {steps.map((s) => <li set:html={nbHtml(s)} />)}
        </ol>
        <p set:html={nbHtml('Žingsniai: <a href="/jei-apgavo/#pinigai">Jei tave apgavo: išsiunčiau pinigus</a>, <a href="/jei-apgavo/#kortele">pasakiau kortelės duomenis</a>.')} />
      </section>

      <div class="cta">
        <a class="btn" href="/jei-apgavo/#pinigai">Jei jau sumokėjai</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Tavo pinigų už daiktą, kurio jis neturi ir neketina atiduoti. <!-- F260 F261 M --> Kartais – ir kortelės ar banko duomenų, jei atsiunčia nuorodą. <!-- F269 --> 2026 m. spalio 13 d. Šilutėje jaunuolis, „Facebook“ tinkle norėjęs nusipirkti „PlayStation 5“, pervedė pardavėjui 260 eurų ir prekės negavo. <!-- F265 --> Rugsėjo 30 d. Šilutės rajone kitas vyras, „Facebook“ tinkle radęs prekę, taip prarado 6 250 eurų. <!-- F266 --> <strong class="stop">Sustabdymo vieta:</strong> pavedimas. Kol daikto nematei, pinigai lieka tavo sąskaitoje. <!-- F262 M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Nieko, ir jam nereikia: jis įkelia skelbimą ir laukia, kas parašys. <!-- M --> Jis žino tik tai, kad tu ieškai būtent tokio daikto ir nenori jo praleisti. <!-- M --> Jo profilis gali mažai ką pasakyti: „Citadele“ banko atstovas sako, kad neseniai sukurtas profilis su mažai draugų, nuotraukų ar įrašų gali būti apgaviko ženklas. <!-- F274 --> <strong class="stop">Sustabdymo vieta:</strong> prieš kalbant apie pinigus, pažiūrėk pardavėjo profilį: kada sukurtas, kiek jame draugų ir įrašų. <!-- F274 M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jis naudoja tris iš penkių kabliukų, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>: <!-- M -->')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
            <p set:html={nbHtml('<strong class="stop">Sustabdymo vieta:</strong> nei sutartis, nei įmonės vardas neįrodo, kad daiktas yra. Įrodo tik daiktas, kurį pamatei. <!-- F267 F272 M -->')} />
            <p set:html={nbHtml('Pinigai gali keliauti per svetimas sąskaitas, o atgauti juos, policijos žodžiais, įmanoma, bet nelengva. <!-- F261 F263 -->')} />
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Kortelės:</strong> <a href="/sustok/desimt-sekundziu/">{nb('Sustok dešimčiai sekundžių')}</a>, <a href="/sustok/nuoroda-ne-is-zinutes/">{nb('Nespausk nuorodos – atsidaryk programėlę ar svetainę')}</a></li>
          <li><strong>Tema:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a></li>
          <li><strong>Kiti scenarijai:</strong> <a href="/scenarijai/pirkejas-skelbime/">{nb('„Pirkėjas“ skelbime')}</a>, <a href="/scenarijai/netikra-parduotuve/">{nb('Netikra el. parduotuvė')}</a>, <a href="/scenarijai/netikra-nuoma/">{nb('Nuoma, kuri neegzistuoja')}</a>, <a href="/scenarijai/bilietas-i-koncerta/">{nb('Bilietas į koncertą iš nepažįstamo žmogaus')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-11-01. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
