---
/**
 * Scenarijus: būrėja prašo vis daugiau pinigų. The copy is
 * docs/copy/scenarijai/bureja-praso-dar.md, word for word; the source tags stay as comments and the build strips them.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';

const title = nb('Būrėja prašo vis daugiau pinigų');
const meta = [
  ['Kanalas', '„Facebook“, telefonas, paieška internete'],
  ['Ko jis nori', 'kad mokėtum vėl ir vėl'],
  ['Skaitymo laikas', '4 min.'],
];

const signs = [
  ['Vis „neužteko“.', 'Sumokėjai, o darbas nebaigtas: reikia dar. Byloje, apie kurią 2022 m. rašė tv3.lt, moteris pasakojo, kad po pirmo mokėjimo jai pasakė, jog „neužteko“, nes „uždėtas daug stipresnis prakeiksmas“. <!-- F591 --> Policijos 2021 m. aprašytu atveju sumos iš pradžių buvo nedidelės, o paskui vis didėjo. <!-- F595 -->'],
  ['Gąsdina tuo, kas tau brangiausia.', 'Jei nesumokėsi, nukentės vaikai, artimieji ar tu. <!-- F591 F593 --> 2015 ir 2022 m. aprašytose bylose žmonėms sakė, kad mirs artimieji, vyras pateks į avariją, gali sudegti namas. <!-- F592 F593 -->'],
  ['Pinigus ar auksą žada „išvalyti“ ir grąžinti.', '<!-- F593 F595 --> Policijos 2021 m. aprašytu atveju pinigus žadėta „įkrauti gera energija“ ir grąžinti, bet apie 32 000 eurų negrįžo. <!-- F596 --> Kitoje 2022 m. aprašytoje byloje žadėta nuimti prakeiksmą nuo papuošalų ir juos grąžinti. <!-- F598 -->'],
];

const before = [
  ['Neimk paskolos ir nesiskolink.', 'Aprašytais atvejais žmonės ėmė kreditus, pirko prekes išsimokėtinai ir skolinosi iš artimųjų. Skola lieka tau. <!-- F592 F593 F606 M -->'],
  ['Neatiduok pinigų ir aukso „išvalyti“.', '<!-- F595 F597 F598 M -->'],
  ['Papasakok.', '2022 m. aprašytoje byloje viena moteris mokėjo slapta, nes bijojo, o kita skolinosi, kol nebeturėjo iš ko. <!-- F592 --> Dar kitai moteriai, pasak jos pačios, griežtai liepta tylėti: kitaip viską teks pradėti iš naujo. Tuo labiau papasakok. <!-- F606 --> Nereikia aiškinti, kuo tiki: užtenka pasakyti, kiek jau sumokėjai ir kiek dar prašo. <!-- M --> Nėra kam pasakyti? Vilties linija <strong>116 123</strong> (suaugusiems) atsiliepia visą parą, nemokamai. <!-- F545 -->'],
  ['Nustojai mokėti ar paprašei pinigų atgal, ir prasidėjo grasinimai?', 'Taip nutiko dviem moterims, apie kurias rašyta 2022 m. <!-- F592 F606 --> 2015 m. teismo pranešime panašūs gąsdinimai aprašyti kaip apgaulės dalis. <!-- F593 --> Žinutes išsaugok, neatsakinėk ir pranešk policijai. Jei bijai, kad kas nors gali ateiti ar tau pakenkti, skambink 112. <!-- F2 F597 M -->'],
];

const steps = [
  '<strong>Daugiau nieko nemokėk,</strong> taip pat už dar vieną ritualą ar už tai, kad pinigus grąžintų. <!-- M -->',
  '<strong>Skambink bankui</strong> numeriu iš oficialios programėlės ar svetainės. Kuo greičiau, tuo didesnė tikimybė bent dalį pinigų sustabdyti ar atsekti. <!-- F13 F186 F339 --> Žingsniai: <a href="/jei-apgavo/#pinigai">Išsiunčiau pinigus</a>.',
  '<strong>Išsaugok viską:</strong> žinutes, sutartį, pavedimus, perlaidų kvitus, numerius, paskyros adresą. <!-- M -->',
  '<strong>Pranešk policijai</strong> per epolicija.lt arba numeriu 112. <!-- F2 F597 --> Aprašyk tiksliai, ką tau sakė: kuo gąsdino, ką žadėjo grąžinti, kiek ir kada sumokėjai. <!-- F608 M -->',
  '<strong>Siūlo atgauti pinigus už mokestį?</strong> Tai <a href="/scenarijai/susigrazinti-pinigus/">kita apgaulė</a>. <!-- F186 -->',
  '<strong>Sunku apie tai kalbėti?</strong> Vilties linija <strong>116 123</strong> suaugusiems ir Jaunimo linija <strong>0 800 28 888</strong> (16–35 m.) atsiliepia visą parą, abi nemokamos. <!-- F545 -->',
];

const levers = [
  ['Autoritetas.', 'Jis prisistato ekspertu, turinčiu galių, kurių neturi kiti. <!-- F600 F598 M -->'],
  ['Baimė.', 'Dėl savęs, vaikų ir artimųjų. <!-- F591 F592 F593 -->'],
  ['Nauda.', 'Viskas susitvarkys, o pinigai grįš. <!-- F590 F593 F595 -->'],
  ['Gėda.', 'Sunku pasakyti artimiesiems, kiek jau atidavei, o tyla jam naudinga. <!-- M -->'],
];

const sides = [
  ['Pirmas kartas nemokamai ar pigiai', 'Nauja suma, apie kurią iš pradžių nekalbėta, yra ženklas sustoti. <!-- F595 F596 F606 M -->'],
  ['„Neužteko“, „daug stipresnis prakeiksmas“', 'Sumokėjus nieko nesibaigia, tik atsiranda nauja suma. Sustok. <!-- F591 M -->'],
  ['„Kitaip vaikams bus blogai“', 'Išsaugok žinutę ir parodyk policijai. <!-- F591 F592 F608 M -->'],
  ['Žada pinigus „išvalyti“ ir grąžinti', 'Neatiduok. Policijos 2021 m. aprašytu atveju pinigai negrįžo. <!-- F595 F596 M -->'],
  ['Sutartis, kad pinigai ar daiktai bus grąžinti', 'Popierius nieko negarantuoja: 2022 m. aprašytoje byloje sutartis buvo apgaulės dalis. Išsaugok ją ir parodyk policijai. <!-- F590 M -->'],
  ['Pinigų nebėra, o jis vis tiek prašo: kreditas, prekės išsimokėtinai', 'Neimk. Skolą mokėsi tu. <!-- F592 F593 M -->'],
  ['Nustojai mokėti, ir prasideda grasinimai', 'Neatsakinėk, išsaugok ir pranešk policijai. <!-- F592 F2 M -->'],
  ['Po nuostolio siūlo atgauti pinigus už mokestį', 'Tai kita apgaulė. Nemokėk. <!-- F186 -->'],
];

const sources = [
  'Teismų bylos: tv3.lt (2022-06-21), teismai.lt (2015-10-29), respublika.lt (2022-06-09), Raseinių naujienos (2022-11-08). <!-- F590 F591 F592 F593 F598 F609 -->',
  'Policija: policija.lrv.lt (2021-02-01), Kauno diena ir 15min (2023-03-02), LRT (2025-12-18; 2025-11-20), tv3.lt (2025-04-28), 15min (2026-10-08), jp.lt (2025-10-08), respublika.lt (2026-04-28). <!-- F595 F596 F597 F600 F601 F602 F603 F604 F605 -->',
  'Spauda: Vakarų ekspresas (2022-10-26), Šilo karčema (2018-06-07), Valstietis (be datos, perpasakoja Aukščiausiojo Teismo nutartį). <!-- F606 F607 F608 -->',
  'Kanados kovos su sukčiavimu centras (atnaujinta 2026-01-16). Užsienio šaltinis. <!-- F599 -->',
  'Lietuvos bankas (2021-07-09; 2026-04-16, apie investicines apgaules, kodėl sunku sustoti), „Luminor“ (laikas.lt, 2026-01-29; paninfo.lt, 2026-05-12), policija (2026-02-05, atnaujinta 2026-04-23): banką pasiekti per oficialią programėlę ar svetainę; „atgavimas“ už mokestį; epolicija.lt. <!-- F13 F339 F350 F186 F2 -->',
  'Pagalba: Vilties linija ir Jaunimo linija (be datos), e. teisingumo portalas (atnaujinta 2025-08-01). <!-- F545 F585 -->',
];
---
<Page
  title="Būrėja prašo pinigų, gąsdina prakeiksmu: ką daryti – Suktas"
  description="Būrėja sako, kad neužteko, gąsdina prakeiksmu ar žada pinigus „išvalyti“ ir grąžinti? Trys ženklai, ką daryti ir kur kreiptis, jei jau sumokėjai."
  current="scenarijai"
>
  <article class="scn">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <h1>{title}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-11-04</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap" aria-labelledby="trumpai">
      <h2 id="trumpai" class="layer__title">Trumpai</h2>

      <p set:html={nbHtml('Šis puslapis ne apie tai, kuo tikėti. Čia kalbame apie pinigus, kurių prašoma vis daugiau. <!-- M -->')} />
      <p set:html={nbHtml('Jau sumokėjai? Eik tiesiai į <a href="#jau-sumokejai">ką daryti</a>.')} />

      <div class="row">
        <h3>Kaip tai atrodo</h3>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Sunkiu metu „Facebook“ ar internete randi būrėją, ekstrasensą ar ritualų žinovą. Arba tokie žmonės parašo ar paskambina patys. <!-- F597 F600 F601 F603 F604 --> Iš pradžių gali kainuoti nedaug ar visai nieko. <!-- F595 F596 F606 --> Paskui tau sako, kad bėda didesnė: prakeiksmas, kurį reikia „valyti“, ritualas, dar vienas mokėjimas. <!-- F591 F606 -->')} />
          <p set:html={nbHtml('Sumos auga. <!-- F595 --> 2025 m. policija pranešė apie žmones, praradusius nuo 1 200 iki 171 089 eurų. <!-- F600 F601 F602 F604 --> Viena moteris 2022 m. pasakojo „Vakarų ekspresui“, kad už kortų metimą sumokėjo 50 svarų, o galiausiai atidavė 43 238. <!-- F606 -->')} />
        </div>
      </div>

      <div class="row">
        <h3>Trys ženklai</h3>
        <ol class="row__body signs" role="list">
          {signs.map(([head, text]) => (
            <li><p><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></p></li>
          ))}
        </ol>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h3 id="ejimas">Tavo ėjimas</h3>
        <p class="move__line" set:html={nbHtml('Daugiau nemokėk, kad ir kuo gąsdintų, ir papasakok žmogui, kuriuo pasitiki. <!-- M -->')} />
        <p set:html={nbHtml('Svarbu ne tai, kuo tiki, o kas vyksta su pinigais. Jei po kiekvieno mokėjimo atsiranda nauja bėda, kurią esą išspręs tik naujas mokėjimas, sustok. <!-- M -->')} />
        <ul>
          {before.map(([head, text]) => (
            <li><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></li>
          ))}
        </ul>
      </section>

      <section class="box" aria-labelledby="jau-sumokejai">
        <h3 id="jau-sumokejai">Jei jau sumokėjai</h3>
        <p set:html={nbHtml('Tai gali nutikti bet kam, ir gėdytis čia nėra ko. <!-- F339 M --> Policijai apie tai 2025–2026 m. pranešė ir moterys, ir vyras, gimę 1950–1987 m. <!-- F600 F601 F603 F604 F605 -->')} />
        <ol>
          {steps.map((s) => <li set:html={nbHtml(s)} />)}
        </ol>
      </section>

      <section class="box" aria-labelledby="ar-gris">
        <h3 id="ar-gris">Ar pinigai grįš?</h3>
        <p set:html={nbHtml('Negalime pažadėti. <!-- M --> Laikraštis „Valstietis“, perpasakodamas Lietuvos Aukščiausiojo Teismo nutartį, rašė: pačios magijos paslaugos įstatymu neuždraustos, bet jei pinigai tyčia išgaunami nepagrįstai teigiant, kad pavojus gresia žmogaus ar artimųjų gyvybei, sveikatai ar turtui, tai jau sukčiavimas. Straipsnis be datos, pačios nutarties neskaitėme. <!-- F608 -->')} />
        <p set:html={nbHtml('Policija tiria ir mažesnes sumas: sukčiavimo tyrimai pradėti ir dėl 1 200 eurų (2025 m.), ir dėl 2 050 eurų (2026 m.). <!-- F603 F604 --> Bet ne visada. 2022 m. „Vakarų ekspresas“ rašė, kad tai pačiai moteriai, atidavusiai 43 238 svarus, policija atsisakė pradėti tyrimą ir pasiūlė ginčą spręsti civiline tvarka, o prokurorai šį sprendimą paliko galioti. <!-- F606 --> 2018 m. „Šilo karčema“ rašė apie 10 eurų už būrimą: tyrimas nutrauktas, nes „tam tikros būrimo paslaugos buvo suteiktos“ ir paslauga nebuvo teikiama viešoje vietoje. <!-- F607 --> Pranešti vis tiek verta: be pranešimo policija apie tai greičiausiai nesužinos. <!-- M -->')} />
        <p set:html={nbHtml('Teismai yra priteisę atlyginti žalą: 2015 m. 29 345,93 euro, 2022 m. 7 701 eurą (už netikrus būrimo mokymus). <!-- F593 F609 --> Kai apie juos buvo pranešta, abu nuosprendžius dar buvo galima skųsti; ar jie liko galioti ir ar pinigai grįžo, šaltiniai nesako. <!-- F593 F609 M --> Nemokamą vienos valandos teisininko konsultaciją, kad ir kokios tavo pajamos, gali gauti bet kurioje savivaldybėje. <!-- F585 -->')} />
      </section>

      <div class="cta">
        <a class="btn" href="/jei-apgavo/#pinigai">Jei jau sumokėjai</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. „Jis“ čia reiškia tą, kuris prašo pinigų, vyras tai ar moteris. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Tavo pinigų – kuo daugiau ir kuo ilgiau. <!-- M --> Ne tik pavedimu: 2023 m. aprašytu atveju žmogus pinigus siuntė per banką ir pašto perlaidomis, pirko ir siuntė auksinius gaminius, o 2015 m. byloje kitas žmogus kreditu pirko telefonus ir kompiuterius. <!-- F597 F593 --> Viena istorija gali trukti savaitę (2026 m. policijai pranešta apie 32 tūkst. eurų per savaitę) ar pusantrų metų (2022 m. aprašytoje byloje – 145 tūkst. eurų). <!-- F605 F592 --> LRT 171 089 eurus pavadino viena didžiausių 2025 m. sukčių išviliotų sumų. <!-- F600 --> Bendro skaičiaus neradome. <!-- M -->')} />
            <p set:html={nbHtml('Panašiai aprašoma ir užsienyje. Kanados kovos su sukčiavimu centras rašo: sumokėjus pirmą mokestį ateina nauja žinutė, kad reikia mokėti dar, kitaip bus uždėtas prakeiksmas. <!-- F599 -->')} />
            <p set:html={nbHtml('<strong class="stop">Sustabdymo vieta:</strong> kiekviena nauja suma, apie kurią iš pradžių nekalbėta. <!-- M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Iš pradžių nedaug: tai, kad ieškai pagalbos, ir ką rodo tavo profilis. <!-- M --> Policijos 2021 m. aprašytu atveju moteris ieškojo pagalbos dėl nelaimingų santykių, prastos sveikatos ir pinigų rūpesčių. <!-- F596 --> Viskas, ką papasakoji, jam praverčia: kas serga, ko bijai, kiek turi. Iš to gimsta nauja „bėda“. <!-- M -->')} />
            <p set:html={nbHtml('<strong class="stop">Sustabdymo vieta:</strong> tai, kad jis žino, ką jam pasakei ar ką rodo tavo profilis, dar neįrodo jokių galių. Daugiau nemokėk. <!-- M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jis naudoja keturis iš penkių kabliukų, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>: <!-- M -->')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
            <p set:html={nbHtml('Kuo daugiau sumokėjai, tuo sunkiau sustoti. <!-- M --> Lietuvos bankas apie investicines apgaules rašo panašiai: žmonės nori atgauti jau įdėtus pinigus. <!-- F350 -->')} />
            <p set:html={nbHtml('<strong class="stop">Sustabdymo vieta:</strong> sustoti galima po bet kurio mokėjimo, ir ankstesnių pinigų naujas mokėjimas nesugrąžins. <!-- M -->')} />
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. Ir jokio vertinimo, kuo tu tiki. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Tema:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a></li>
          <li><strong>Kiti scenarijai:</strong> <a href="/scenarijai/meile-internete/">{nb('Meilė internete, kuri prašo pinigų')}</a>, <a href="/scenarijai/susigrazinti-pinigus/">{nb('„Padėsime susigrąžinti pinigus“')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-11-04. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <p class="printnote noprint">{nb('Spausdink iš naršyklės – puslapis tam paruoštas.')}</p>
    </footer>
  </article>
</Page>
