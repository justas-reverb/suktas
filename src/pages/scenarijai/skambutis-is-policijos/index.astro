---
/**
 * Scenarijus: Skambutis iš „policijos“. The copy is docs/copy/scenarijai/skambutis-is-policijos.md,
 * word for word; the source tags stay as comments and the build strips them.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('Skambutis iš „policijos“');
const meta = [
  ['Kanalas', 'skambutis'],
  ['Ko jis nori', 'kodų, prieigos ir pinigų'],
  ['Skaitymo laikas', '3 min.'],
];

const signs = [
  ['Prašo asmens kodo, slaptažodžių ar kortelės duomenų.', 'Pareigūnai jų telefonu neprašo, o „Smart-ID“ sako, kad niekada neprašo PIN kodų. <!-- F25 F30 -->'],
  ['Prašo leisti matyti ekraną, įdiegti programą ar prisijungti prie bankininkystės kartu.', 'Bankų asociacija sako: bankų ir teisėsaugos vardu apsimetantiems prisijungimo duomenų duoti ir ekrano rodyti negalima, o jų prašomos programos dažnai skirtos nuotoliniam prisijungimui. <!-- F27 F51 -->'],
  ['Nori, kad patikėtum vien dėl to, kad prisistatė pareigūnu.', 'Pavadinimas ar numeris ekrane neįrodo, kas skambina. <!-- F38 F39 -->'],
];

const levers = [
  ['Autoritetas.', 'Su įstaiga paprastai nesiginčijama, todėl prisistatymas pareigūnu verčia klausyti. <!-- M --> Apsimetinėjimas pareigūnais yra viena iš penkių schemų, kurias aprašo kampanija „Padėk ragelį“. <!-- F23 -->'],
  ['Baimė.', 'Kalbos apie pavojų tavo pinigams ar vardui verčia veikti greitai, o ne mąstyti. <!-- M -->'],
  ['Skuba.', 'Kai skubi, nespėji paskambinti kam nors kitam. <!-- M -->'],
];

const sides = [
  ['Prisistato pareigūnu', 'Tai ne įrodymas. Padėk ragelį; jei įtari netikrą pareigūną – 112. <!-- F4 F38 F39 -->'],
  ['Taisyklinga kalba, pažįstamas balsas, pareigūnas vaizdo skambutyje', 'Nei garsas, nei vaizdas nebėra tikrovės įrodymas; menkiausios abejonės atveju baik pokalbį ir patikrink oficialiais kanalais. <!-- F97 -->'],
  ['Prašo asmens kodo, slaptažodžių ar kortelės duomenų', 'Pareigūnai jų telefonu neprašo. <!-- F25 -->'],
  ['„Smart-ID“ PIN', '„Smart-ID“ PIN neprašo; prašymą, kurio nepradėjai, atšauk. <!-- F30 F32 -->'],
  ['Ekrano rodymas, programa, bendras prisijungimas', 'Neleisk, neįdiek ir neprisijunk kartu. <!-- F27 F51 -->'],
  ['Vėliau „institucija“ siūlo susigrąžinti pinigus už mokestį', 'Tai antras apgavimas. Nemokėk. <!-- F14 F16 -->'],
];

const sources = [
  'Kampanija „Padėk ragelį“ (LRT, policija, Bankų asociacija, Lietuvos paštas): netikri pareigūnai, patarimai, 112. <!-- F4 F23 F25 -->',
  'Bankų asociacija: apsimetantys banku ir teisėsauga; nuotolinio prisijungimo programos; „institucijos“, siūlančios susigrąžinti pinigus. <!-- F16 F27 F51 -->',
  'Lietuvos bankas, 2024-10-28: „susigrąžinimo“ pasiūlymai už mokestį. <!-- F14 -->',
  '„Smart-ID“ (SK ID Solutions): PIN kodų neprašo; nepradėtas prašymas – „Atšaukti“. <!-- F30 F32 -->',
  'RRT, 2023-10-20 ir 2026-08-10: suklastoti numeriai ir kaip sukčiai skambina dabar. <!-- F38 F39 -->',
  'Lietuvos bankas, 2021-07-09: kreiptis į banką per oficialią programėlę ar svetainę. <!-- F13 -->',
  'Lietuvos bankas su kampanijos „Padėk ragelį“ partneriais, 2025-12-15: pareigūnai neskambina prašydami asmens duomenų ar slaptažodžių; šokas, spaudimas, skuba – baik pokalbį. <!-- F96 -->',
  'Bankų asociacija, 2026-03-16: kalba be akcento, avatarai vaizdo skambutyje; nei vaizdas, nei garsas nėra įrodymas. <!-- F97 -->',
];
---
<Page
  title="Skambutis iš „policijos“: sukčiai apsimeta pareigūnais – Suktas"
  description="Kaip atrodo netikro pareigūno skambutis, trys jo ženklai ir vienas ėjimas, kuris sustabdo planą."
  current="scenarijai"
>
  <article class="scn">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <h1>{title}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-10-25</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap" aria-labelledby="trumpai">
      <h2 id="trumpai" class="layer__title">Trumpai</h2>

      <div class="row">
        <h3>Kaip tai atrodo</h3>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Skambina nepažįstamas numeris. Pašnekovas prisistato pareigūnu: policijos, banko, mobiliojo ryšio operatoriaus ar kitos įstaigos vardu. <!-- F23 --> Kalba oficialiai ir ramiai, o pavadinimas ar numeris ekrane nieko neįrodo. <!-- M F38 F39 --> Dabar jis gali kalbėti taisyklinga lietuvių kalba be akcento, o vaizdo skambutyje pasirodyti kaip avataras – „pareigūnas“. <!-- F97 --> Tada paprašo to, ko tikras pareigūnas telefonu neprašytų: asmens kodo, bankininkystės slaptažodžių ar kortelės duomenų. <!-- F25 -->')} />
        </div>
      </div>

      <div class="row">
        <h3>Trys ženklai</h3>
        <ol class="row__body signs" role="list">
          {signs.map(([head, text]) => (
            <li><p><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></p></li>
          ))}
        </ol>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h3 id="ejimas">Tavo ėjimas</h3>
        <p class="move__line" set:html={nbHtml('Padėk ragelį.')} />
        <p set:html={nbHtml('Jei įtari netikrą pareigūną – skambink 112, o dėl savo pinigų – banko numeriu iš oficialios programėlės ar svetainės. <!-- F4 F13 --> Pareigūnai neskambina prašydami asmens duomenų ar prisijungimo slaptažodžių; jei skambutis kelia šoką, spaudimą ar skubą, baik pokalbį. <!-- F96 --> Kortelė: <a href="/sustok/padek-ragely/">Padėk ragelį ir skambink oficialiu numeriu</a>.')} />
      </section>

      <section class="box" aria-labelledby="padarei">
        <h3 id="padarei">Jei jau prisigavai</h3>
        <p set:html={nbHtml('Jei jau pasakei duomenis ar išsiuntei pinigus, pirmiausia skambink bankui. Žingsniai: <a href="/jei-apgavo/#pinigai">Jei tave apgavo: išsiunčiau pinigus</a>.')} />
      </section>

      <div class="cta">
        <a class="btn" href="/sustok/padek-ragely/">Atidaryk kortelę</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Sukčiui reikia, kad veiksmą atliktum tu: pasakytum duomenis, įsileistum jį į savo įrenginį ar išsiųstum pinigus. <!-- F25 F27 F51 --> Pareigūno vaidmuo jam padeda išsklaidyti tavo atsargumą. <!-- M --> <strong class="stop">Sustabdymo vieta:</strong> pareigūnai telefonu neprašo asmens kodo, slaptažodžių ar kortelės duomenų, todėl pats prašymas yra ženklas padėti ragelį. <!-- F25 -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Pradžiai sukčiui užtenka telefono numerio. <!-- M --> Visa kita jis bando išgirsti iš tavęs, todėl kiekvienas tavo atsakymas jam naudingas. <!-- M --> <strong class="stop">Sustabdymo vieta:</strong> neatsakinėk į klausimus apie save ir padėk ragelį. <!-- M -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Veikia trys kabliukai, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>:')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Kortelės:</strong> <a href="/sustok/padek-ragely/">{nb('Padėk ragelį ir skambink oficialiu numeriu')}</a>, <a href="/sustok/desimt-sekundziu/">{nb('Sustok dešimčiai sekundžių')}</a></li>
          <li><strong>Tema:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a></li>
          <li><strong>Kiti scenarijai:</strong> <a href="/scenarijai/skambutis-is-banko/">{nb('Skambutis iš „banko“')}</a>, <a href="/scenarijai/zinute-su-kodu/">{nb('Žinutė su kodu')}</a>, <a href="/scenarijai/pareigunas-prie-duru/">{nb('„Pareigūnas“ prie durų')}</a>, <a href="/scenarijai/skambutis-is-poliklinikos/">{nb('Skambutis iš „poliklinikos“')}</a>, <a href="/scenarijai/artimojo-avarija/">{nb('„Tavo sūnus pateko į avariją“')}</a></li>
          <li><strong>Žodynas:</strong> <a href="/zodynas/phishing/">{nb('Kas yra phishing')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-10-25. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
