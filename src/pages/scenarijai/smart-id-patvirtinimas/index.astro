---
/**
 * Scenarijus: „Patvirtink per „Smart-ID““. The copy is docs/copy/scenarijai/smart-id-patvirtinimas.md,
 * word for word; the source tags stay as comments and the build strips them.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const title = nb('„Patvirtink per „Smart-ID““');
const meta = [
  ['Kanalas', 'svetainė ar skambutis'],
  ['Ko jis nori', 'kad patvirtintum jo prisijungimą ir mokėjimą'],
  ['Skaitymo laikas', '3 min.'],
];

const signs = [
  ['Užklausa atsirado ne dėl to, ką pradėjai tu.', 'Ją sukėlė skambutis, žinutė, kieno nors atsiųsta nuoroda ar paieškos reklama, o ne tai, ką darei banko programėlėje ar ranka įvestu banko adresu. <!-- F171 F167 F169 M -->'],
  ['Jungiesi, o prašoma PIN2.', 'Prisijungiant prie interneto banko reikia tik PIN1. Jei „Smart-ID“ lange matai mokėjimą, tvirtini pinigų pervedimą. <!-- F169 F165 -->'],
  ['Kažkas aiškina, kodėl reikia patvirtinti.', '„Kad apsaugotume sąskaitą“, „kad atšauktume įtartiną mokėjimą“, „kad gautum pinigus“. <!-- F171 F170 --> Joks banko ar „Smart-ID“ darbuotojas niekada neprašo įvesti PIN – dėl jokių priežasčių. <!-- F164 F165 -->'],
];

const levers = [
  ['Autoritetas.', 'Netikras puslapis atrodo kaip banko, o užklausa telefone tikra, todėl visa grandinė atrodo patikima. <!-- F169 M -->'],
  ['Baimė.', 'Žodžiai „sąskaitą reikia apsaugoti“ ar „įtartinas mokėjimas“ verčia skubėti, ir mintis perskaityti, ką tvirtini, nebeateina. <!-- F171 M --> <strong class="stop">Sustabdymo vieta:</strong> jei skambinantis prašo ką nors patvirtinti, baik pokalbį ir paskambink bankui jo oficialiu numeriu. <!-- F171 F13 -->'],
  ['Nauda.', 'Pažadas „pinigus gausi, kai patvirtinsi“ PIN2 kodą paverčia tarsi mygtuku pinigams gauti, nors juo tvirtinamas pinigų išsiuntimas. <!-- F170 F165 M --> <strong class="stop">Sustabdymo vieta:</strong> pinigams gauti PIN2 nereikia. <!-- F165 F170 -->'],
];

const sides = [
  ['Paieškoje viena pirmųjų nuorodų veda į netikrą „banką“', 'Prie banko junkis per jo programėlę arba adresą įvesk ranka; netikro puslapio adresas visada skiriasi. <!-- F169 F164 -->'],
  ['Jungiesi, bet „Smart-ID“ rodo mokėjimą', 'Prisijungimui reikia tik PIN1; mokėjimo, kurio nepradėjai, PIN2 netvirtink. <!-- F169 F165 -->'],
  ['Patvirtinai PIN1, o puslapis vis „kraunasi“ arba vėl prašo patvirtinti', 'Uždaryk puslapį ir skambink bankui oficialiu numeriu: tai aiškus ženklas, kad gali vykti apgaulė. <!-- F170 F13 -->'],
  ['Užklausa, kurios nepradėjai', 'Spausk „Atšaukti“ arba nieko nedaryk: po kelių minučių ji baigsis. <!-- F166 -->'],
  ['„Banko darbuotojas“ prašo patvirtinti, kad apsaugotų sąskaitą ar atšauktų mokėjimą', 'Baik pokalbį ir susisiek su banku numeriu iš jo programėlės ar svetainės. <!-- F171 F13 -->'],
  ['„Pirkėjas“ siunčia nuorodą pinigams gauti', 'PIN2 tvirtina pervedimus ir parašus, ne pinigų gavimą. <!-- F165 --> Lietuvos bankas viename ginče nusprendė, kad bankas neprivalo grąžinti 4 720 eurų žmogui, kuris „pinigams gauti“ PIN2 kodu patvirtino mokėjimus. <!-- F170 -->'],
  ['SMS ar el. laiškas: „atnaujink „Smart-ID““', 'Paskyra atnaujinama tik pačioje programėlėje; nuorodos nespausk. <!-- F167 -->'],
  ['Prašo PIN, „tik dviejų paskutinių skaitmenų“ ar PIN atbuline tvarka', 'Nei „Smart-ID“, nei bankai, nei valstybės įstaigos niekada neprašo pasakyti PIN. <!-- F164 F165 -->'],
  ['Siūlo „tik išbandyti“ užklausą', 'Netvirtink: „Smart-ID“ įspėja, kad už veiksmus, patvirtintus tavo PIN kodais, gali tekti atsakyti tau. <!-- F164 -->'],
  ['Automatinis skambutis „Smart-ID“ vardu', 'Padėk ragelį: „Smart-ID“ automatiniais skambučiais su klientais nebendrauja. <!-- F167 -->'],
];

const sources = [
  '„Smart-ID“ (SK ID Solutions), sukčiavimo vadovas: PIN niekada neprašomas; „išbandyti“ netvirtinti; svetainę atsidaryti ranka; jei PIN pateko į kitų rankas – bankas, policija, „Smart-ID“. <!-- F164 -->',
  '„Smart-ID“, PIN kodai: PIN1 – prisijungti, PIN2 – pavedimams ir parašams; bankai ir valstybės įstaigos PIN neprašo. <!-- F165 -->',
  '„Smart-ID“ DUK: užklausa, kurios nepradėjai, – „Atšaukti“; patikrinti saugos kodą ir veiksmo aprašymą. <!-- F166 -->',
  '„Smart-ID“ įspėjimas: paskyra atnaujinama tik programėlėje; automatinių skambučių nėra. <!-- F167 -->',
  '„Smart-ID“ DUK ir LRT, 2026-02-25: „Smart-ID+“ ir jo diegimas etapais. <!-- F168 F34 -->',
  '„Smart-ID“ DUK apie QR kodus: skenuoti tik patikimų paslaugų kodus, tikrinti paslaugos pavadinimą ir veiksmą. <!-- F35 -->',
  '15min (Vakarų ekspresas), 2026-04-24: Klaipėdos atvejis ir SEB paaiškinimas, kaip per netikrą banko svetainę išgaunami PIN1 ir PIN2 patvirtinimai. <!-- F169 -->',
  'tv3.lt, 2026-04-12: Lietuvos banko sprendimas ginče dėl PIN2, įvesto „pinigams gauti“, ir „Luminor“ įspėjimas apie įtartinai dažnas užklausas. <!-- F170 -->',
  'Alkas.lt, 2026-10-28, cituojant „Luminor“ specialistą: skambutis, prašantis patvirtinti „sąskaitai apsaugoti“. <!-- F171 -->',
  'Lietuvos bankas: į banką kreiptis per oficialią programėlę ar svetainę. <!-- F13 -->',
  'Policija, 2026-02-05: nukentėjus pranešti per epolicija.lt. <!-- F2 -->',
];
---
<Page
  title="„Smart-ID“ sukčiai: prašo patvirtinti ar įvesti PIN – Suktas"
  description="Kaip sukčiai įkalba „Smart-ID“ programėlėje patvirtinti jų prisijungimą ir mokėjimą: trys ženklai ir vienas ėjimas, kuris tai sustabdo."
  current="scenarijai"
>
  <article class="scn">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <h1>{title}</h1>
        <dl class="meta">
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd set:html={nbHtml(v)} /></div>)}
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-10-31</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap" aria-labelledby="trumpai">
      <h2 id="trumpai" class="layer__title">Trumpai</h2>

      <div class="row">
        <h3>Kaip tai atrodo</h3>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('Ieškai savo banko internete ir spaudi vieną pirmųjų nuorodų. <!-- F169 --> Puslapis atrodo kaip banko, tik adresas kitas. <!-- F169 --> Įvedi prisijungimo duomenis, ir telefone pasirodo tikra „Smart-ID“ užklausa, lyg jungtumeisi prie banko. <!-- F169 --> Įvedi PIN1, o puslapis vis „kraunasi“. <!-- F169 --> Tada ateina dar viena užklausa, jau su suma ir gavėju, ir prašo PIN2. <!-- F169 --> Tą patį prašymą patvirtinti gali atnešti ir skambutis iš „banko“ ar „pirkėjo“ nuoroda skelbimų portale. <!-- F171 F170 -->')} />
        </div>
      </div>

      <div class="row">
        <h3>Trys ženklai</h3>
        <ol class="row__body signs" role="list">
          {signs.map(([head, text]) => (
            <li><p><strong set:html={nbHtml(head)} /> <Fragment set:html={nbHtml(text)} /></p></li>
          ))}
        </ol>
      </div>

      <section class="move" aria-labelledby="ejimas">
        <h3 id="ejimas">Tavo ėjimas</h3>
        <p class="move__line" set:html={nbHtml('Prieš įvedant PIN, perskaityk, ką tvirtini. Jei to nepradėjai tu, spausk „Atšaukti“.')} />
        <p set:html={nbHtml('Prie banko junkis per jo programėlę arba adresą įvesk ranka, ne per paieškos reklamą ar žinutės nuorodą. <!-- F164 F169 M --> Kortelė: <a href="/sustok/kodai-ir-pin/">Kodų ir PIN niekam nesakyk</a>.')} />
        <p set:html={nbHtml('Išbandyk tai saugiai: <a href="/treniruote/smart-id/">treniruotėje</a> su išgalvota programėle spaudi ten, kur spaustum iš tikrųjų, ir pamatai, ką tuo metu daro sukčius. <!-- pažadas -->')} />
      </section>

      <section class="box" aria-labelledby="padarei">
        <h3 id="padarei">Jei jau prisigavai</h3>
        <p set:html={nbHtml('Tai gali nutikti bet kam. <!-- M --> Jei prisijungimo duomenis ar PIN1 įvedei netikrame puslapyje arba PIN2 kodu patvirtinai mokėjimą, kurio nenorėjai, iškart skambink bankui numeriu iš oficialios programėlės ar svetainės: kartais dalį pervedimų dar pavyksta sustabdyti. <!-- F164 F13 F170 --> Pranešk ir policijai. <!-- F164 F2 --> Jei PIN kam nors pasakei arba vis gauni užklausų, kurių nepradėjai, kreipkis į „Smart-ID“. <!-- F164 --> Žingsniai: <a href="/jei-apgavo/#kodai">Jei tave apgavo: pasakiau ar įvedžiau kodą</a>.')} />
      </section>

      <div class="cta">
        <a class="btn" href="/sustok/kodai-ir-pin/">Atidaryk kortelę</a>
      </div>
    </section>

    <details class="stage" open>
      <summary>
        <h2 class="stage__title">Kaip tai daro jis</h2>
      </summary>
      <ArtBand mood="stage" class="stage__art" sizes="(min-width: 60rem) 70vw, 120vw" />
      <div class="stage__in wrap">
        <p class="stage__note">Šis sluoksnis jau atvertas. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.</p>

        <div class="row">
          <h3>Ko jis nori</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jam reikia dviejų tavo patvirtinimų: PIN1, kad patektų į tavo interneto banką, ir PIN2, kad iš jo pervestų pinigus. <!-- F169 F165 --> Paties PIN jam net nereikia sužinoti: užtenka, kad jį įvestum tu. <!-- F169 M --> <strong class="stop">Sustabdymo vieta:</strong> PIN įvesk tik tam veiksmui, kurį pradėjai tu. <!-- F165 F166 -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Ką jis apie tave žino</h3>
          <div class="row__body">
            <p set:html={nbHtml('Iš anksto – beveik nieko: jis nežino, kuriame banke esi, tik tikisi, kad savo banko ieškosi internete ir paspausi jo reklamą. <!-- F169 M --> Prisijungimo duomenis jis gauna tada, kai juos įvedi jo puslapyje. <!-- F169 --> Skambindamas jis gali žinoti ir tavo asmens duomenis. <!-- F165 --> Tačiau „Smart-ID“ lange matyti, ką iš tikrųjų tvirtini: mokėjimui – suma ir gavėjas. <!-- F169 F170 --> <strong class="stop">Sustabdymo vieta:</strong> perskaityk tą langą iki galo, net jei skambinantis skubina. <!-- F169 F171 -->')} />
          </div>
        </div>

        <div class="row">
          <h3>Kodėl tai veikia</h3>
          <div class="row__body">
            <p set:html={nbHtml('Veikia kabliukai, kuriuos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>:')} />
            <ul class="levers" role="list">
              {levers.map(([name, text]) => (
                <li><strong>{name}</strong> <span set:html={nbHtml(text)} /></li>
              ))}
            </ul>
            <p set:html={nbHtml('Naujasis „Smart-ID+“ šią schemą gerokai apsunkina: asmens kodo svetainėje vesti nebereikia, o prisijungimas susiejamas su programėle nuskenavus QR kodą arba kai programėlė pati atsidaro tame pačiame telefone. <!-- F168 --> Tačiau paslaugos jį diegia palaipsniui, todėl 2026 m. vasarį senuoju būdu dar buvo jungiamasi. <!-- F34 F168 --> <strong class="stop">Sustabdymo vieta:</strong> QR kodą skenuok tik banko puslapyje, kurį atsidarei ranka įvestu adresu, ir patikrink, ar programėlėje rodomas tas pats paslaugos pavadinimas ir veiksmas. <!-- F35 F164 -->')} />
          </div>
        </div>

        <section class="sides" aria-labelledby="sustoti">
          <h3 id="sustoti">Kur jį sustabdyti</h3>
          <table>
            <thead>
              <tr><th scope="col">Jo triukas</th><th scope="col">Tavo atsakymas</th></tr>
            </thead>
            <tbody>
              {sides.map(([his, yours]) => (
                <tr>
                  <td data-label="Jo triukas" set:html={nbHtml(his)} />
                  <td data-label="Tavo atsakymas" set:html={nbHtml(yours)} />
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <div class="row row--last">
          <h3>Ko čia nerasi</h3>
          <div class="row__body">
            <p set:html={nbHtml('Jokių įrankių, paruošto teksto ar žingsnių, kaip tai padaryti. Tai mūsų <a href="/misija/#riba">riba</a>. <!-- pažadas -->')} />
          </div>
        </div>
      </div>
    </details>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Kortelės:</strong> <a href="/sustok/kodai-ir-pin/">{nb('Kodų ir PIN niekam nesakyk')}</a>, <a href="/sustok/padek-ragely/">{nb('Padėk ragelį ir skambink oficialiu numeriu')}</a>, <a href="/sustok/nuoroda-ne-is-zinutes/">{nb('Nespausk nuorodos – atsidaryk programėlę ar svetainę')}</a></li>
          <li><strong>Tema:</strong> <a href="/temos/apgaule/">{nb('Apgaulė ir sukčiavimas')}</a></li>
          <li><strong>Kiti scenarijai:</strong> <a href="/scenarijai/skambutis-is-banko/">{nb('Skambutis iš „banko“')}</a>, <a href="/scenarijai/pirkejas-skelbime/">{nb('„Pirkėjas“ skelbime')}</a>, <a href="/scenarijai/netikra-banko-reklama/">{nb('Netikra banko reklama')}</a>, <a href="/scenarijai/paskola-tavo-vardu/">{nb('Paskola tavo vardu, kurios neėmei')}</a></li>
          <li><strong>Žodynas:</strong> <a href="/zodynas/phishing/">{nb('Kas yra phishing')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-10-31. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
