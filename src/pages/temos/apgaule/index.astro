const related = [
  ['Kitos temos:', '<a href="/temos/slaptazodziai/">Slaptažodžiai ir prieigos raktai</a>, <a href="/temos/kaip-veikia-atakos/">Kaip veikia atakos</a>, <a href="/temos/socialine-inzinerija/">Socialinė inžinerija</a>'],
  ['Kortelės:', '<a href="/sustok/">Įpročiai</a>'],
  ['Žodynas:', '<a href="/zodynas/#sukciavimas-apsimetant">Sukčiavimas apsimetant</a>, <a href="/zodynas/#nuotolinis-prisijungimas">Nuotolinis prisijungimas</a>, <a href="/zodynas/phishing/">Kas yra phishing</a>, <a href="/zodynas/pinigu-mulas/">Kas yra pinigų mulas</a>, <a href="/zodynas/nelegalus-kazino/">Kas yra nelegalus kazino</a>, <a href="/zodynas/piramide/">Kas yra finansinė piramidė</a>, <a href="/zodynas/lazybu-prognozes/">Kas yra mokamos lažybų prognozės</a>, <a href="/zodynas/greito-uzdarbio-kursai/">Kas yra greito uždarbio kursai</a>, <a href="/zodynas/di-prenumerata/">Kas yra DI programėlės prenumerata</a>'],
];

const sources = [
  'Kampanija „Padėk ragelį“: schemos, frazės, patarimai, 112. <!-- F4 F23 F24 F25 -->',
  'Lietuvos bankas: banko ir prisijungimo patarimai; „susigrąžinimo“ pasiūlymai; reklamos su žinomais veidais. <!-- F13 F14 F26 F50 -->',
  'RRT: suklastoti numeriai ir pokalbių programėlės. <!-- F38 F39 -->',
  'NKSC, 2026-07-13: pokalbių programėlių paskyrų perėmimas. <!-- F41 -->',
  '„Lietuvos paštas“, „Omniva“: netikros žinutės apie siuntinius. <!-- F44 F45 -->',
  'FBI IC3: šeimos žodis. <!-- F80 F81 -->',
  'Generalinė prokuratūra (LRT, 2025-12-16): Eurojusto koordinuota operacija prieš skambučių centrų tinklą. <!-- F695 -->',
];
---
<Page
  title="Apgaulė ir sukčiavimas – Suktas"
  description="Triukai, kuriais sukčius apgauna žmogų, ir vienas ėjimas, kuris jų daugumą sustabdo."
  current="temos"
>
  <article class="scn topic">
    <PillarHead
      title="Apgaulė ir sukčiavimas"
      lead="Čia surinkti triukai, kuriais sukčius apgauna žmogų, o ne programą: skambutis, žinutė, reklama. Skirta kiekvienam, kam skambina ir rašo. <!-- pažadas -->"
      actions={[
        ['Atidaryk kortelę „Sustok dešimčiai sekundžių“', '/sustok/desimt-sekundziu/'],
        ['Jei tave ką tik apgavo', '/jei-apgavo/', 'sos'],
      ]}
    />

    <section class="layer wrap" aria-labelledby="siandien">
      <section class="move">
        <h2 id="siandien">Vienas dalykas šiandien</h2>
        <p class="move__line" set:html={nbHtml('Sustok dešimčiai sekundžių ir paklausk savęs: ar šį veiksmą pradėjau aš?')} />
        <p set:html={nbHtml('Jei ne – nutrauk. <!-- F26 F32 --> Kortelė: <a href="/sustok/desimt-sekundziu/">Sustok dešimčiai sekundžių</a>.')} />
      </section>
    </section>

    <section class="part wrap" aria-labelledby="triukai">
      <h2 id="triukai" class="layer__title">Triukai, kuriuos čia matome</h2>
      <ul class="cards" role="list">
        {tricks.map(([title, href, text]) => (
          <li class="tcard">
            <h3><a href={href}>{nb(title)}</a></h3>
            <p class="tcard__text" set:html={nbHtml(text)} />
          </li>
        ))}
      </ul>
    </section>

    <PillarStage note="Šis sluoksnis uždarytas ir atsidaro paspaudus. Jame – tik tai, ko jis nori ir kodėl jam pavyksta. Paaiškinimas yra mūsų pačių modelis, o faktai pažymėti šaltiniais.">
      <div class="row">
        <h3>Ko jis nori iš šios srities</h3>
        <div class="row__body">
          <p set:html={nbHtml('Sukčiui reikia, kad veiksmą atliktum tu: pasakytum kodą, įvestum duomenis, įsileistum jį į įrenginį ar išsiųstum pinigus. <!-- F25 F26 F51 --> Jis nesilaužia pro duris, o prašo, kad tu jas atidarytum. <!-- M --> Už skambučio gali būti organizuotas skambučių centras. 2025 m. gruodį Lietuvos, Latvijos, Čekijos ir Ukrainos pareigūnai išardė tinklą, kuris, įtariama, valdė skambučių centrus: skambintojai gaudavo iki 7 proc. to, ką išviliodavo, o nukentėjo daugiau kaip 400 žmonių Europos šalyse, tarp jų ir Lietuvoje. <!-- F695 --> Skambintojas gauna dalį to, ką išvilioja, todėl spaudžia ir skubina. <!-- F695 M --> <strong class="stop">Sustabdymo vieta:</strong> oficialioje programėlėje daryk tik tas operacijas, kurias pradėjai tu. <!-- F26 -->')} />
        </div>
      </div>
      <div class="row">
        <h3>Ką jis jau žino ar gali sužinoti</h3>
        <div class="row__body">
          <p set:html={nbHtml('Pradžiai užtenka mažai: telefono numerio, banko pavadinimo, žinomo vardo. <!-- M --> Daugiau jam duoda tai, ką pasakai pokalbio metu. <!-- M --> <strong class="stop">Sustabdymo vieta:</strong> nieko apie save nepasakyk tam, kuris skambina pats, ir padėk ragelį. <!-- F13 -->')} />
        </div>
      </div>
      <div class="row">
        <h3>Kodėl tai veikia</h3>
        <div class="row__body">
          <p set:html={nbHtml('Veikia penki kabliukai: skuba, autoritetas, baimė, gėda ir nauda; juos aprašome <a href="/temos/kaip-veikia-atakos/">vienoje vietoje</a>. <!-- M --> Kampanijos „Padėk ragelį“ cituojamos frazės („paskyra bus užblokuota“, „būtina patvirtinti“) skubina ir gąsdina. <!-- F24 --> <strong class="stop">Sustabdymo vieta:</strong> tikras bankas neskubina ir nesiunčia nuorodų. <!-- F25 -->')} />
        </div>
      </div>
      <Sides heads={['Jo triukas', 'Tavo atsakymas']} rows={sides} />
    </PillarStage>

    <PillarFoot
      related={related}
      intro="Patikrinta: 2026-11-07. Faktai surašyti <a href='/saltiniai/'>Šaltiniuose</a>:"
      sources={sources}
    />
  </article>
</Page>
