---
/**
 * Apgaulė ir sukčiavimas: the pillar for tricks played on a person. The copy is
 * docs/copy/temos/apgaule.md, word for word; the source tags stay as comments and the build strips
 * them. The head, the one move and the stage are the pillar template (components/Pillar*); the
 * five scenarios are cards of his, as on the shelves.
 */
import Page from '../../../layouts/Page.astro';
import PillarHead from '../../../components/PillarHead.astro';
import PillarStage from '../../../components/PillarStage.astro';
import Sides from '../../../components/Sides.astro';
import PillarFoot from '../../../components/PillarFoot.astro';
import { nb, nbHtml } from '../../../lib/typo.js';
import '../../../styles/shelf.css';
import '../../../styles/scenario.css';
import '../../../styles/pillar.css';

const tricks = [
