  ['Netikra banko reklama', '/scenarijai/netikra-banko-reklama/', 'kai paieškos reklama banko vardu veda į netikrą jo svetainę. <!-- F213 F214 -->'],
  ['Netikras QR kodas', '/scenarijai/netikras-qr-kodas/', 'kai QR lipdukas ant parkomato veda į netikrą mokėjimo puslapį. <!-- F235 -->'],
  ['Programėlė iš nuorodos ar reklamos', '/scenarijai/programele-is-nuorodos/', 'kai reklama ar žinutė siūlo programėlę, kuri perima telefoną. <!-- F224 -->'],
  ['Netikras konkursas', '/scenarijai/netikras-konkursas/', 'kai parduotuvės vardu žadamas prizas, o jam atsiimti prašoma kortelės duomenų. <!-- F367 F368 -->'],
