/**
 * Įrankiai: GrapheneOS, a tool article. The copy is docs/copy/irankiai/grapheneos.md, word for word;
 * the source tags stay as comments and the build strips them. Same shape as /irankiai/mullvad/.
 * Bank apps and Smart-ID are said only as their sources say them: neither promised nor ruled out.
 */
import Page from '../../../layouts/Page.astro';
import ArtBand from '../../../components/ArtBand.astro';
import { nb, nbHtml, sourceHtml } from '../../../lib/typo.js';
import '../../../styles/scenario.css';
import Share from '../../../components/Share.astro';

const suits = [
  ['Jei nori, kad „Google“ gautų mažiau.', ' „Google“ paslaugų sistemoje nėra, o įdiegta „Google Play“ yra paprasta programėlė be ypatingos prieigos. <!-- F970 F975 -->'],
  ['Jei nori ilgai gauti atnaujinimus.', ' „Pixel“ telefonai nuo 8-osios kartos turi bent 7 metų palaikymo garantiją nuo jų pasirodymo, o atnaujinimai atsisiunčiami patys, fone. <!-- F971 F977 -->'],
  ['Jei jau turi „Pixel“ arba vis tiek jį pirksi.', ' Kitų telefonų sistema nepalaiko. <!-- F971 -->'],
];

const before = [
  ['Banko programėlės ir „Smart-ID“.', ' Pati „GrapheneOS“ rašo, kad banko programėlės – ypač problemiškos, bet daugeliui jų pakanka tame pačiame telefono profilyje įdiegti „Google Play“. <!-- F976 --> „Google“ šios sistemos nesertifikuoja, o „GrapheneOS“ tikrinimų neapeina. <!-- F976 --> „Smart-ID“ rašo, kad neveikia telefonuose su „root“ teisėmis ir palaiko „Android“ ir „iOS“; apie „GrapheneOS“ jos puslapiai nieko nesako. <!-- F980 --> Ar veiks tavo banko programėlė ir „Smart-ID“, iš anksto pasakyti negalime. <!-- M -->'],
  ['Diegiant telefonas ištrinamas.', ' Dingsta visi duomenys, todėl pirma pasidaryk atsarginę kopiją. <!-- F973 M -->'],
  ['Operatoriaus užrakintas telefonas.', ' Į tokį sistemos gali nepavykti įdiegti; tai daugiausia JAV operatorių bėda. <!-- F972 -->'],
];

const steps = [
  ['Telefonas.', ' Kūrėjai rekomenduoja pirkti tik „Pixel 8“ ar naujesnį (iki „Pixel 10a“) ir ne operatoriaus versiją. <!-- F971 F972 -->'],
  ['Atsarginė kopija.', ' Išsaugok nuotraukas ir kontaktus, o antro žingsnio kodus (autentifikavimo programėlę) perkelk į kitą įrenginį – kitaip gali nebeprisijungti prie savo paskyrų. <!-- M --> Diegiant „Smart-ID“ ir banko programėlės ištrinamos, todėl jas teks užregistruoti iš naujo, net jei veiks. <!-- F973 M --> Prieš diegiant žinok, kaip prisijungsi prie banko be šio telefono. <!-- M F980 -->'],
  ['Tik oficialus diegimo įrankis:', ' <a href="https://grapheneos.org/install/web">grapheneos.org/install/web</a>. <!-- F973 --> Trečiųjų šalių instrukcijos dažnai pasenusios. <!-- F973 --> Reikės kompiuterio su „Chrome“, „Edge“ ar kita „Chromium“ naršykle ir USB laido. <!-- F973 -->'],
  ['Pabaigoje užrakink įkrovos tvarkyklę', ' (angl. <em>bootloader</em>): tik tada veikia visas patikrintas paleidimas. <!-- F973 -->'],
  ['Palik automatinius atnaujinimus įjungtus.', ' <!-- F977 -->'],
  ['Jei reikia „Google“ programėlių,', ' „Google Play“ įsidiek iš „GrapheneOS“ programėlių parduotuvės. <!-- F975 -->'],
];

const watch = [
  ['Ar sistema tikra.', ' Turint antrą „Android“ telefoną, programėle „Auditor“ galima patikrinti, ar telefono įranga ir sistema tikros. <!-- F974 -->'],
  ['VPN.', ' Kūrėjai iš VPN programėlių rekomenduoja tik oficialią „WireGuard“ arba <a href="/irankiai/mullvad/">„Mullvad“</a> programėlę. <!-- F979 -->'],
  ['Naršyklė.', ' Numatytoji naršyklė – sustiprinta „Vanadium“. <!-- F977 -->'],
];

const sources = [
  '„GrapheneOS“ (pagrindinis puslapis, DUK, funkcijos, naudojimas, diegimas, parama): kas tai, telefonai, atnaujinimai, „Google Play“, banko programėlės, diegimas, „Auditor“, VPN, licencija. <!-- F970 F971 F972 F973 F974 F975 F976 F977 F978 F979 -->',
  '„Smart-ID“ pagalba (SK ID Solutions): „root“ teisės, palaikomos sistemos, saugumo patikros klaida. <!-- F980 -->',
];

const list = (items) => items.map(([head, text]) => `<li><strong>${nbHtml(head)}</strong>${nbHtml(text)}</li>`).join('');
---
<Page
  title="GrapheneOS: kas tai ir ar verta ją diegti – Suktas"
  description="„GrapheneOS“ – privatumui ir saugumui skirta „Pixel“ telefonų sistema. Kam ji tinka, ką žinoti apie banko programėles ir „Smart-ID“ ir kaip ją įdiegti."
>
  <article class="scn card">
    <header class="scn-head">
      <ArtBand mood="day" class="scn-head__art" sizes="(min-width: 60rem) 70vw, 120vw" eager />
      <div class="wrap scn-head__body">
        <p class="crumb"><a href="/irankiai/">Įrankiai</a></p>
        <h1>{nb('GrapheneOS: kas tai ir ar verta ją diegti')}</h1>
        <dl class="meta">
          <div><dt>Skaitymo laikas</dt><dd>4 min.</dd></div>
          <div><dt>Patikrinta</dt><dd><span class="nw">2026-11-07</span> (<a href="/saltiniai/">Šaltiniai</a>)</dd></div>
        </dl>
      </div>
    </header>

    <section class="layer wrap">
      <div class="row">
        <h2>Trumpai</h2>
        <div class="row__body">
          <p class="lead" set:html={nbHtml('„GrapheneOS“ – privatumui ir saugumui skirta telefono operacinė sistema, kurioje veikia „Android“ programėlės. <!-- F970 --> Ją kuria ne pelno siekiantis atviro kodo projektas, įkurtas 2014 m. <!-- F970 --> Joje nėra „Google“ paslaugų, o „Google Play“ gali įsidiegti kaip paprastą programėlę, be jokių ypatingų teisių. <!-- F970 F975 --> Ji veikia tik „Google Pixel“ telefonuose ir atsisiunčiama nemokamai. <!-- F971 F978 --> Šios svetainės autorius ją naudoja savo telefone. <!-- pažadas -->')} />
        </div>
      </div>

      <div class="row">
        <h2>Kam verta</h2>
        <div class="row__body"><ul class="row-list" set:html={list(suits)} /></div>
      </div>

      <div class="row">
        <h2>Prieš diegiant</h2>
        <div class="row__body"><ul class="row-list" set:html={list(before)} /></div>
      </div>

      <div class="row">
        <h2>Kaip pradėti</h2>
        <div class="row__body"><ol class="row-list" set:html={list(steps)} /></div>
      </div>

      <div class="row">
        <h2>Ką stebėti</h2>
        <div class="row__body"><ul class="row-list" set:html={list(watch)} /></div>
      </div>

      <div class="cta">
        <a class="btn" href="/irankiai/#k-grapheneos">Kortelė Įrankiuose</a>
        <a class="btn btn--second" href="/irankiai/">Visi įrankiai</a>
      </div>
    </section>

    <footer class="scn-foot wrap">
      <section class="related" aria-labelledby="susije">
        <h2 id="susije">Susiję</h2>
        <ul>
          <li><strong>Įrankiai:</strong> <a href="/irankiai/mullvad/">Mullvad VPN</a>, <a href="/irankiai/tailscale/">Tailscale</a></li>
          <li><strong>Temos:</strong> <a href="/temos/irenginiai/">{nb('Įrenginiai ir tinklas')}</a></li>
        </ul>
      </section>

      <section class="sources" aria-labelledby="saltiniai">
        <h2 id="saltiniai">Šaltiniai ir patikrinta</h2>
        <p set:html={nbHtml('Patikrinta: 2026-11-07. Šiame puslapyje naudoti faktai (visi su datomis <a href="/saltiniai/">Šaltiniuose</a>):')} />
        <ul>
          {sources.map((s) => <li set:html={sourceHtml(s)} />)}
        </ul>
      </section>

      <Share />
    </footer>
  </article>
</Page>
